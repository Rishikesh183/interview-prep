  "apis": [
    {
      "id": "a1",
      "ownerNodeId": "upload",
      "method": "POST",
      "path": "/v1/videos",
      "request": "{ \"title\": \"demo\", \"sizeBytes\": 104857600, \"contentType\": \"video/mp4\" }",
      "response": "201 { \"videoId\": \"v1\", \"uploadId\": \"u1\", \"uploadUrls\": [] }",
      "statusCodes": "201, 400, 413",
      "auth": true,
      "note": "API returns signed upload parts; the creator sends media bytes to raw object storage."
    },
    {
      "id": "a2",
      "ownerNodeId": "upload",
      "method": "POST",
      "path": "/v1/videos/{id}/complete",
      "request": "{ \"uploadId\": \"u1\", \"parts\": [{ \"number\": 1, \"etag\": \"...\" }] }",
      "response": "202 { \"videoId\": \"v1\", \"status\": \"PROCESSING\" }",
      "statusCodes": "202, 409",
      "auth": true,
      "idempotent": true,
      "note": "Use an outbox/object-store event and dedup processing version; duplicate completion must not publish incomplete media."
    },
    {
      "id": "a3",
      "ownerNodeId": "video",
      "method": "GET",
      "path": "/v1/videos/{id}/manifest",
      "request": "No request body.",
      "response": "200 { \"manifestUrl\": \"https://cdn/video/v1/master.m3u8\", \"renditions\": [\"240p\",\"720p\"] }",
      "statusCodes": "200, 404, 409",
      "auth": false,
      "idempotent": true,
      "note": "The player fetches HLS/DASH segments from CDN and switches bitrate adaptively."
    }
  ],
  "entities": [
    {
      "name": "Video",
      "fields": "video_id: string PK\nowner_id: string\ntitle: string\nstatus: UPLOADING|PROCESSING|READY|FAILED\nmanifest_key: string?\nrenditions: string[]",
      "storeNodeId": "db"
    },
    {
      "name": "MediaObject",
      "fields": "object_key: string PK\nvideo_id: string\nprocessing_version: string\nkind: raw|segment|manifest\nchecksum: string",
      "storeNodeId": "raw"
    }
  ]
