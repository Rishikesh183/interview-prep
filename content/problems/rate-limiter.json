{
  "id": "rate-limiter",
  "number": 3,
  "title": "Rate Limiter",
  "difficulty": "easy",
  "priority": true,
  "tags": ["algorithms", "redis", "distributed-counters"],
  "prompt": "Design a distributed rate limiter that protects a public API. Limits are configurable per user / API key (e.g. 100 requests per minute). Requests over the limit are rejected. The limiter runs across many API servers.",
  "functionalReqs": [
    "Limit requests per client key (user, IP or API key) per time window",
    "Configurable rules per endpoint / tier",
    "Reject over-limit requests with a clear error",
    "Expose remaining quota to clients"
  ],
  "nonFunctionalReqs": [
    "Adds < 5 ms latency per request",
    "Accurate across many limiter instances",
    "Highly available: limiter failure must not take down the API"
  ],
  "scale": {
    "qps": "~1M requests/s across the fleet",
    "dau": "~10M API keys",
    "storage": "Counter state only: ~100 B per key per window"
  },
  "outOfScope": ["Billing for overages", "DDoS protection at the network layer"],
  "hints": [
    "Token bucket, leaky bucket, fixed window, sliding log, sliding window counter: which trade-off fits?",
    "If each API server counts locally, limits are multiplied by the number of servers.",
    "Read-then-write on a shared counter has a race. How do you make it atomic?"
  ],
  "keyComponents": ["api_gateway", "rate_limiter", "cache", "service"],
  "deepDives": [
    "Token bucket vs sliding window trade-offs",
    "Atomic counters in Redis with Lua scripts",
    "Fail-open vs fail-closed when Redis is down",
    "Multi-region limits"
  ],
  "rubricFocus": [
    "Correct algorithm choice with justification",
    "Shared atomic state",
    "Failure behaviour"
  ],
  "tests": [
    {
      "id": "limiter-in-path",
      "desc": "Requests pass through a limiter before reaching services",
      "check": {
        "anyOf": [
          {
            "pathExists": {
              "from": "client",
              "via": ["rate_limiter"],
              "to": "service"
            }
          },
          {
            "pathExists": {
              "from": "client",
              "via": ["api_gateway"],
              "to": "service"
            }
          }
        ]
      },
      "hint": "Place a rate limiter (or gateway with rate limiting) between clients and services."
    },
    {
      "id": "shared-counters",
      "desc": "Counters live in a shared store so all limiter instances agree",
      "check": {
        "edgeMatch": {
          "from": ["rate_limiter", "api_gateway", "service"],
          "to": "cache"
        }
      },
      "hint": "Store counters in Redis (or similar) instead of local memory."
    },
    {
      "id": "algorithm",
      "desc": "A limiting algorithm is chosen",
      "check": {
        "mentions": "token.?bucket|leaky.?bucket|sliding.?window|fixed.?window|sliding.?log"
      }
    },
    {
      "id": "atomic",
      "desc": "Counter updates are atomic",
      "check": {
        "mentions": "lua|atomic|incr|multi|compare.?and"
      },
      "hint": "Use INCR/EXPIRE or a Lua script so concurrent requests don't race."
    },
    {
      "id": "reject-signal",
      "desc": "Rejected requests get 429 with retry information",
      "check": {
        "mentions": "429|retry.?after|x-ratelimit|too many"
      }
    },
    {
      "id": "failure-mode",
      "desc": "Behaviour when the limiter store is down is defined",
      "check": {
        "mentions": "fail.?open|fail.?closed|fallback|degrade"
      }
    },
    {
      "id": "scale-out",
      "desc": "Every service sits behind a load balancer or API gateway",
      "check": {
        "upstreamOf": "service",
        "anyType": "entry"
      },
      "hint": "Put a load balancer or API gateway in front of your services so they can scale horizontally."
    }
  ],
  "references": [
    {
      "id": "gateway-redis",
      "name": "Gateway middleware + Redis token bucket",
      "summary": "The API gateway runs the limiter as middleware. Token buckets per API key live in a Redis cluster and are refilled lazily inside a Lua script (atomic read-modify-write). Over-limit → 429 with Retry-After.",
      "tradeoffs": [
        "No extra network hop beyond Redis",
        "Token bucket allows bursts up to bucket size",
        "Fail open if Redis is unavailable to protect availability"
      ],
