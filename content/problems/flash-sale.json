            "type": "scheduler",
            "position": {
              "x": 0,
              "y": 130
            },
            "data": {
              "label": "Unpaid sweeper",
              "config": {
                "cron": "* * * * *",
                "purpose": ""
              },
              "note": "Release stock (INCR) after a 10 min payment timeout"
            }
          }
        ],
        "edges": [
