# Server-side only. Never prefix with NEXT_PUBLIC_.
# Get a key at https://openrouter.ai/keys (free models need no credits, but are rate-limited).
OPENROUTER_API_KEY=

# Any OpenRouter model id. Free ones end in ":free". List: https://openrouter.ai/models?q=free
REVIEW_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Comma-separated fallbacks, tried in order if the main model is rate-limited or down.
REVIEW_FALLBACK_MODELS=qwen/qwen3.8-27b:free,openrouter/free
# Reasoning models: low | medium | high | none. "low" keeps free models fast (default).
REVIEW_REASONING_EFFORT=low
