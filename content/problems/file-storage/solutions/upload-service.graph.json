{
  "v": 1,
  "n": [
    {
      "i": "client",
      "t": "mobile_client",
      "x": 0,
      "y": 0,
      "l": "Clients",
      "no": "Mobile caller with intermittent connectivity for dropbox / google drive."
    },
    {
      "i": "gw",
      "t": "api_gateway",
      "x": 280,
      "y": 0,
      "l": "Gateway",
      "no": "Authenticate, apply admission limits and route requests for dropbox / google drive."
    },
    {
      "i": "up",
      "t": "service",
      "x": 560,
      "y": 0,
      "l": "Upload Service",
      "no": "Resumable chunked upload; SHA-1 per chunk for dedup"
    },
    {
      "i": "sync",
      "t": "service",
      "x": 560,
      "y": 180,
      "l": "Sync Service",
      "no": "Long-poll /changes; conflicting edits keep both versions"
    },
    {
      "i": "blobs",
      "t": "object_storage",
      "x": 840,
      "y": 0,
      "l": "Chunk storage",
      "no": "Persist immutable large objects for dropbox / google drive."
    },
    {
      "i": "meta",
      "t": "nosql_document",
      "x": 840,
      "y": 180,
      "l": "Metadata",
      "c": {
        "shardKey": "user_id"
      },
      "no": "Store documents and their versioned lifecycle for dropbox / google drive."
    }
  ],
  "e": [
    {
      "i": "e1",
      "s": "client",
      "d": "gw",
      "l": "Authenticated request",
      "h": "r>l"
    },
    {
      "i": "e2",
      "s": "gw",
      "d": "up",
      "l": "Call Upload Service",
      "h": "r>l"
    },
    {
      "i": "e3",
      "s": "gw",
      "d": "sync",
      "a": "a4",
      "l": "Call Sync Service",
      "h": "r>l"
    },
    {
      "i": "e4",
      "s": "up",
      "d": "blobs",
      "o": "w",
      "l": "Read / write state",
      "h": "r>l"
    },
    {
      "i": "e5",
      "s": "up",
      "d": "meta",
      "o": "w",
      "l": "Read / write state",
      "h": "r>l"
    },
    {
      "i": "e6",
      "s": "sync",
      "d": "meta",
      "o": "r",
      "l": "Read / write state",
      "h": "r>l"
    }
  ],
  "apis": [
    {
      "id": "a1",
      "ownerNodeId": "up",
      "method": "POST",
      "path": "/v1/files/{path}/upload-session",
      "request": "{ \"blocks\": [{ \"hash\": \"sha256...\", \"size\": 4194304 }] }",
      "response": "201 { \"uploadId\": \"u1\", \"missingBlocks\": [], \"uploadUrls\": [] }",
      "statusCodes": "201, 400, 403",
      "auth": true,
      "note": "Presigned mode returns signed object-store URLs; upload-service mode returns service chunk URLs."
    },
    {
      "id": "a2",
      "ownerNodeId": "up",
      "method": "PUT",
      "path": "/v1/uploads/{id}/chunks/{n}",
      "request": "Binary chunk body; Content-Range and checksum headers.",
      "response": "200 { \"chunk\": 0, \"checksum\": \"sha256...\" }",
      "statusCodes": "200, 400, 403",
      "auth": true,
      "idempotent": true,
      "note": "Retry the same chunk number and checksum safely; metadata commit is a separate operation."
    },
    {
      "id": "a3",
      "ownerNodeId": "up",
      "method": "POST",
      "path": "/v1/files/{path}/commit",
      "request": "{ \"uploadId\": \"u1\", \"expectedVersion\": 2, \"blockHashes\": [\"sha256...\"] }",
      "response": "201 { \"fileId\": \"f1\", \"version\": 3 }",
      "statusCodes": "201, 409",
      "auth": true,
      "note": "Commit the version and change cursor atomically; incomplete blocks must not become a visible file."
    },
    {
      "id": "a4",
      "ownerNodeId": "sync",
      "method": "GET",
      "path": "/v1/changes",
      "request": "No request body; ?cursor=42&limit=100",
      "response": "200 { \"changes\": [], \"nextCursor\": \"43\" }",
      "statusCodes": "200, 403",
      "auth": true,
      "idempotent": true,
      "pagination": "cursor",
      "note": "A durable cursor recovers missed WebSocket hints or long-poll responses."
    }
  ],
  "entities": [
    {
      "name": "FileVersion",
      "fields": "file_id: string\nversion: int64\nowner_id: string\npath: string\nblock_hashes: string[]\nupdated_at: timestamp",
      "storeNodeId": "meta"
    },
    {
      "name": "Block",
      "fields": "block_hash: string PK\nobject_key: string\nsize_bytes: int64\nchecksum: string",
      "storeNodeId": "blobs"
    }
  ]
}
