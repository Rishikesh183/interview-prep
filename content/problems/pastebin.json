      },
      "apis": [
        {
          "id": "a1",
          "ownerNodeId": "svc",
          "method": "POST",
          "path": "/v1/pastes",
          "auth": true,
          "request": "{ content, language?, expiresIn? }",
          "response": "{ key, url }",
          "statusCodes": "201, 400, 413"
        },
        {
          "id": "a2",
          "ownerNodeId": "svc",
          "method": "GET",
          "path": "/v1/pastes/{key}",
          "auth": false,
          "statusCodes": "200, 404, 410"
        }
      ],
      "entities": [
        {
          "name": "Paste",
          "fields": "key PK, s3_key, size, language, created_at, expires_at"
        }
      ]
    },
    {
      "id": "kv-with-ttl",
      "name": "Key-value store with native TTL",
      "summary": "Small pastes (<64 KB) go straight into a KV store (DynamoDB) with a TTL attribute; large ones spill to S3. Expiry is handled by the store itself.",
      "tradeoffs": [
        "No cleanup job for small pastes",
        "Item size limits force a split path",
        "TTL deletion is eventually consistent; check expires_at on read"
      ]
    }
  ]
}
