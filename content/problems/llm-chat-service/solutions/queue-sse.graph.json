      "path": "/v1/conversations/{id}/messages",
      "request": "{ \"requestId\": \"r1\", \"content\": \"Explain caching\", \"maxTokens\": 512 }",
      "response": "200 text/event-stream: event=token data={\"text\":\"Cache\"}; event=done data={\"requestId\":\"r1\",\"usage\":512}",
