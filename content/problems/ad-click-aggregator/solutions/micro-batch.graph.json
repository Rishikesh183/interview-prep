  "apis": [
    {
      "id": "a1",
      "ownerNodeId": "click",
      "method": "GET",
      "path": "/c/{clickId}",
      "request": "No request body; signed ad/campaign tracking parameters.",
      "response": "302 Location: https://advertiser.example/product",
      "statusCodes": "302, 400, 404, 503",
      "auth": false,
      "idempotent": true,
      "note": "Acknowledge/log durably before counting; duplicate click IDs do not produce duplicate billable events."
    },
    {
      "id": "a2",
      "ownerNodeId": "query",
      "method": "GET",
      "path": "/v1/ads/{adId}/metrics",
      "request": "No request body; ?start=0&end=3600&bucket=1m",
      "response": "200 { \"buckets\": [{ \"start\": 0, \"clicks\": 42 }], \"asOf\": 3600 }",
      "statusCodes": "200, 403, 400",
      "auth": true,
      "idempotent": true,
      "note": "Expose the aggregation freshness and late-event correction policy; operational totals and settled billing can differ."
    }
  ],
