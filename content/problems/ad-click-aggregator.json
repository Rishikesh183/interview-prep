{
  "id": "ad-click-aggregator",
  "number": 27,
  "title": "Ad Click Aggregator",
  "difficulty": "hard",
  "tags": ["stream-processing", "exactly-once", "olap"],
  "prompt": "Design a system that records ad clicks, redirects users to the advertiser, and lets advertisers query click counts per ad per minute in near real time, accurate enough for billing.",
  "functionalReqs": [
    "Record clicks and redirect to the advertiser URL",
    "Aggregate clicks per ad per minute",
    "Query counts over time ranges with filters",
    "Reconcile for billing"
  ],
  "nonFunctionalReqs": [
    "No double counting (billing!)",
    "Query results within ~1 minute of the click",
    "Handle 10K+ clicks/s with spikes"
  ],
  "scale": {
    "qps": "~10K clicks/s avg, 50K peak",
    "storage": "~1 B clicks/day raw; aggregates much smaller"
  },
  "outOfScope": ["Ad serving / auctions", "Fraud ML"],
  "hints": [
    "Counting in the click handler doesn't scale and loses data on crashes.",
    "What window do aggregates use?",
    "Stream results might drift. How do you get billing-grade numbers?"
  ],
  "keyComponents": [
    "service",
    "event_stream",
    "stream_processor",
    "data_warehouse",
    "batch_processor",
    "object_storage"
  ],
  "deepDives": [
    "Windowed aggregation",
    "Exactly-once / idempotent sinks",
    "Late events and watermarks",
    "Lambda vs Kappa reconciliation"
  ],
  "rubricFocus": [
    "Ingestion via stream",
    "Windowed aggregation",
    "Dedup / exactly-once",
    "OLAP query store"
  ],
  "tests": [
    {
      "id": "ingest",
      "desc": "Clicks are written to a stream",
      "check": {
        "edgeMatch": {
          "to": "event_stream"
        }
      }
    },
    {
      "id": "aggregation",
      "desc": "A stream processor aggregates clicks in windows",
      "check": {
        "nodeConfig": {
          "type": "stream_processor",
          "config": {
            "windowing": ["tumbling", "sliding", "session"]
          }
        }
      }
    },
    {
      "id": "dedup",
      "desc": "Duplicate clicks are not double counted",
      "check": {
        "mentions": "dedup|idempot|exactly.?once|click.?id"
      }
    },
    {
      "id": "olap",
      "desc": "Aggregates are stored for fast range queries",
      "check": {
        "hasNode": ["data_warehouse", "time_series_db", "wide_column", "sql_db"]
      }
    },
    {
      "id": "reconcile",
      "desc": "Batch reconciliation for billing accuracy",
      "check": {
        "anyOf": [
          {
            "hasNode": "batch_processor"
          },
          {
            "mentions": "reconcil"
          }
        ]
      }
    },
    {
      "id": "late-events",
      "desc": "Late events / watermarks are handled",
      "check": {
        "mentions": "late|watermark"
      }
    },
    {
      "id": "redirect",
      "desc": "The click endpoint redirects to the advertiser",
      "check": {
        "apiMatch": {
          "method": "GET",
          "path~": "click|redirect"
        }
      }
    },
    {
      "id": "query-api",
      "desc": "Advertisers query aggregates",
      "check": {
        "apiMatch": {
          "method": "GET",
          "path~": "metric|stat|count|aggregat|report"
        }
      }
    }
  ],
  "references": [
    {
      "id": "kappa-flink",
      "name": "Kafka + Flink + OLAP",
      "summary": "Click service logs click_id + ad_id to Kafka and 302-redirects. Flink dedups by click_id, aggregates in 1-min tumbling windows with watermarks for late events, and writes to an OLAP store (ClickHouse/Pinot) with idempotent upserts. Raw clicks also land in S3; a nightly Spark job recomputes for billing reconciliation.",
      "tradeoffs": ["Near-real-time + accurate billing", "Two code paths to keep consistent"],
