  "apis": [
    {
      "id": "a1",
      "ownerNodeId": "orders",
      "method": "POST",
      "path": "/v1/payments",
      "request": "{ \"idempotencyKey\": \"checkout42\", \"amountMinor\": 10000, \"currency\": \"INR\", \"paymentToken\": \"provider-token\" }",
      "response": "201/202 { \"paymentId\": \"p1\", \"status\": \"PROCESSING\" }",
      "statusCodes": "201, 202, 400, 402, 409",
      "auth": true,
      "idempotent": true,
      "note": "Return the prior result for the same key and payload. A timeout does not mean the provider failed; reconcile by provider reference."
    },
    {
      "id": "a2",
      "ownerNodeId": "orders",
      "method": "GET",
      "path": "/v1/payments/{id}",
      "request": "No request body.",
      "response": "200 { \"paymentId\": \"p1\", \"status\": \"SUCCEEDED\" }",
      "statusCodes": "200, 403, 404",
      "auth": true,
      "idempotent": true,
      "note": "Only an authorized caller sees this payment; settlement and payment authorization are distinct states."
    }
  ],
