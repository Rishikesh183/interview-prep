{
  "id": "notification-system",
  "number": 10,
  "title": "Notification System",
  "difficulty": "medium",
  "priority": true,
  "tags": ["queues", "retries", "dlq", "idempotency"],
  "prompt": "Design a notification service that other internal services call to send push, email and SMS notifications to users. It must respect user preferences, retry failures and never spam users with duplicates.",
  "functionalReqs": [
    "Send push / email / SMS via one API",
    "Respect user channel preferences and opt-outs",
    "Templates with variables",
    "Scheduled and bulk notifications",
    "Delivery status tracking"
  ],
  "nonFunctionalReqs": [
    "At-least-once delivery with deduplication (no double sends)",
    "One slow provider must not block other channels",
    "Soft real-time: < 5 s for transactional messages"
  ],
  "scale": {
    "qps": "~10M notifications/day avg, bursts of 100K/s for campaigns",
    "dau": "~100M users",
    "storage": "~1 KB per notification log entry, 90-day retention"
  },
  "outOfScope": ["Building the email/SMS providers themselves"],
  "hints": [
    "If SMS provider is slow, should push notifications wait?",
    "What happens when a provider returns 500? And after 5 failures?",
    "A caller retries the API call after a timeout. How do you avoid sending twice?"
  ],
  "keyComponents": [
    "api_gateway",
    "service",
    "message_queue",
    "worker",
    "external_service",
    "sql_db",
    "cache"
  ],
  "deepDives": [
    "Queue per channel and isolation",
    "Retries with backoff + DLQ",
    "Idempotency keys",
    "Preferences and rate limiting per user"
  ],
  "rubricFocus": ["Channel isolation", "Retry/DLQ strategy", "Deduplication"],
  "tests": [
    {
      "id": "async",
      "desc": "Sending is decoupled from the API with a queue",
      "check": {
        "edgeMatch": {
          "to": "queue",
          "mode": "async"
        }
      }
    },
    {
      "id": "per-channel",
      "desc": "Each channel has its own queue/topic so slow providers are isolated",
      "check": {
        "anyOf": [
          {
            "hasNode": "message_queue",
            "min": 2
          },
          {
            "hasNode": "event_stream",
            "min": 2
          },
          {
            "mentions": "per.?channel|topic per|queue per"
          }
        ]
      }
    },
    {
      "id": "workers",
      "desc": "Workers consume from the queues",
      "check": {
        "pathExists": {
          "from": "queue",
          "to": "worker"
        }
      }
    },
    {
      "id": "providers",
      "desc": "External providers (APNs, FCM, SES, Twilio) are integrated",
      "check": {
        "pathExists": {
          "from": "worker",
          "to": "external_service"
        }
      }
    },
    {
      "id": "retries",
      "desc": "Failures are retried with backoff and dead-lettered",
      "check": {
        "mentions": "retr|backoff|dead.?letter|dlq"
      }
    },
    {
      "id": "preferences",
      "desc": "User preferences / opt-outs are checked",
      "check": {
        "anyOf": [
          {
            "entityMatch": {
              "name~": "pref|setting|subscription"
            }
          },
          {
            "mentions": "preference|opt.?out|unsubscribe"
          }
        ]
      }
    },
    {
      "id": "dedup",
      "desc": "Duplicate sends are prevented",
      "check": {
        "anyOf": [
          {
            "apiMatch": {
              "method": "POST",
              "idempotent": true
            }
          },
          {
            "mentions": "idempot|dedup"
          }
        ]
      }
    },
    {
      "id": "send-api",
      "desc": "An API accepts notification requests",
      "check": {
        "apiMatch": {
          "method": "POST",
          "path~": "notif|send|message"
        }
      }
    },
    {
      "id": "scale-out",
      "desc": "Every service sits behind a load balancer or API gateway",
      "check": {
        "upstreamOf": "service",
        "anyType": "entry"
      },
      "hint": "Put a load balancer or API gateway in front of your services so they can scale horizontally."
    }
  ],
  "references": [
    {
      "id": "queue-per-channel",
      "name": "Queue per channel",
      "summary": "The notification service validates the request, checks preferences (cached), dedups on an idempotency key, renders the template and enqueues to the channel's SQS queue. Channel workers call the provider with exponential backoff; after 5 attempts messages go to the DLQ.",
      "tradeoffs": [
        "Strong isolation between channels",
        "Many queues to operate",
        "At-least-once + idempotency key ≈ effectively once"
      ],
