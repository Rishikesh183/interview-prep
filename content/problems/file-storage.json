{
  "id": "file-storage",
  "number": 13,
  "title": "Dropbox / Google Drive",
  "difficulty": "medium",
  "priority": true,
  "tags": ["chunking", "presigned-urls", "sync", "metadata"],
  "prompt": "Design a file storage and sync service like Dropbox. Users upload files from any device, files sync to all their devices, and they can share files with others.",
  "functionalReqs": [
    "Upload and download files up to 50 GB",
    "Automatic sync across a user's devices",
    "Share files/folders with other users",
    "File version history"
  ],
  "nonFunctionalReqs": [
    "Files are never lost (11 nines durability)",
    "Uploads resume after network failures",
    "Sync latency a few seconds",
    "Minimize bandwidth for small edits to large files"
  ],
  "scale": {
    "dau": "~50M DAU",
    "qps": "~2 file changes/user/day → ~1.2K writes/s; reads ~5×",
    "storage": "~500 PB total, avg file 1 MB"
  },
  "outOfScope": ["Real-time collaborative editing", "Full-text search in files"],
  "hints": [
    "Uploading a 10 GB file in one request fails often. Split it?",
    "If only 1 MB of a 1 GB file changed, what needs to be uploaded?",
    "How do the other devices learn that something changed?"
  ],
  "keyComponents": [
    "service",
    "object_storage",
    "sql_db",
    "message_queue",
    "websocket_server",
    "cdn"
  ],
  "deepDives": [
    "Chunking and content-addressed blocks",
    "Presigned URLs",
    "Metadata DB design",
    "Sync protocol and conflict resolution"
  ],
  "rubricFocus": [
    "Chunked, resumable uploads",
    "Metadata vs blob separation",
    "Sync notification mechanism",
    "Conflict handling"
  ],
  "tests": [
    {
      "id": "chunking",
      "desc": "Files are split into chunks for resumable upload",
      "check": {
        "mentions": "chunk|block|resum|multipart"
      }
    },
    {
      "id": "blob-store",
      "desc": "File content lives in object storage",
      "check": {
        "hasNode": "object_storage"
      }
    },
    {
      "id": "metadata",
      "desc": "File metadata is stored in a database",
      "check": {
        "hasNode": "db"
      }
    },
    {
      "id": "upload-path",
      "desc": "Clients can get bytes into object storage",
      "check": {
        "pathExists": {
          "from": "client",
          "to": "object_storage"
        }
      }
    },
    {
      "id": "sync-notify",
      "desc": "Other devices are notified of changes",
      "check": {
        "anyOf": [
          {
            "hasNode": "websocket_server"
          },
          {
            "hasNode": "pub_sub"
          },
          {
            "mentions": "long.?poll|notif"
          }
        ]
      }
    },
    {
      "id": "conflicts",
      "desc": "Concurrent edits / conflicts are handled",
      "check": {
        "mentions": "conflict|version|vector clock|last.?writ"
      }
    },
    {
      "id": "dedup",
      "desc": "Identical chunks are deduplicated",
      "check": {
        "mentions": "dedup|hash|checksum|sha|content.?address"
      }
    },
    {
      "id": "upload-api",
      "desc": "An API starts or performs uploads",
      "check": {
        "apiMatch": {
          "method": ["POST", "PUT"],
          "path~": "file|upload|chunk|block"
        }
      }
    },
    {
      "id": "file-entity",
      "desc": "The data model tracks file versions / chunks",
      "check": {
        "entityMatch": {
          "fields~": "version|chunk|block|hash"
        }
      }
    }
  ],
  "references": [
    {
      "id": "presigned-blocks",
      "name": "Block server with presigned URLs",
      "summary": "Client splits files into 4 MB blocks and hashes each (SHA-256). It asks the metadata service which blocks are missing, uploads only those directly to S3 using presigned URLs, then commits a new file version. A notification service pushes change events to the user's other devices over WebSockets.",
      "tradeoffs": [
        "Only changed blocks are uploaded (delta sync)",
        "Content-addressed blocks dedupe across users",
        "Commit step must be atomic in the metadata DB"
      ],
      "graph": {
        "nodes": [
          {
            "id": "client",
            "type": "web_client",
            "position": {
              "x": 0,
              "y": 0
            },
            "data": {
              "label": "Desktop client",
              "config": {},
              "note": "Chunks files into 4 MB blocks, SHA-256 each"
            }
          },
          {
