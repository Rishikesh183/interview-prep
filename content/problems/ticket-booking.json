{
  "id": "ticket-booking",
  "number": 15,
  "title": "Ticket Booking (BookMyShow)",
  "difficulty": "medium",
  "priority": true,
  "tags": ["seat-locking", "concurrency", "payments", "idempotency"],
  "prompt": "Design a movie/event ticket booking system like BookMyShow. Users browse shows, pick specific seats, hold them for a few minutes while paying, and get a confirmed booking. Popular shows sell out in minutes.",
  "functionalReqs": [
    "Browse events and see the seat map",
    "Select seats and hold them for ~10 minutes",
    "Pay and confirm the booking",
    "Release seats if payment fails or the hold expires"
  ],
  "nonFunctionalReqs": [
    "No double booking, ever",
    "Seat map reads are fast and highly available",
    "Survives traffic spikes for popular releases",
    "Payments are not charged twice"
  ],
  "scale": {
    "dau": "~10M DAU",
    "qps": "~1K bookings/s at peak; seat-map reads ~50K/s",
    "storage": "~1M shows × 300 seats"
  },
  "outOfScope": ["Dynamic pricing", "Recommendations"],
  "hints": [
    "Two users click the same seat at the same millisecond. Who wins, and how is that enforced?",
    "Where does the 10-minute hold live, and what removes it?",
    "Payment provider times out. The user retries. What prevents a double charge?"
  ],
  "keyComponents": [
    "load_balancer",
    "service",
    "sql_db",
    "cache",
    "external_service",
    "message_queue"
  ],
  "deepDives": [
    "Pessimistic vs optimistic locking",
    "Distributed locks with TTL",
    "Payment idempotency",
    "Waiting room for flash traffic"
  ],
  "rubricFocus": [
    "Concurrency control preventing double booking",
    "Hold expiry",
    "Payment idempotency"
  ],
  "tests": [
    {
      "id": "seat-hold",
      "desc": "Seats are held/locked during checkout",
      "check": {
        "mentions": "lock|hold|reserv"
      }
    },
    {
      "id": "hold-expiry",
      "desc": "Holds expire and release seats",
      "check": {
        "mentions": "ttl|expir|timeout|release"
      }
    },
    {
      "id": "double-booking",
      "desc": "Double booking is prevented by the datastore or locks",
      "check": {
        "mentions": "double.?book|unique|optimistic|for update|serializ|compare.?and|setnx|atomic"
      },
      "hint": "Explain the exact mechanism that guarantees one winner per seat."
    },
    {
      "id": "strong-store",
      "desc": "Bookings use a strongly consistent store",
      "check": {
        "anyOf": [
          {
            "hasNode": "sql_db"
          },
          {
            "nodeConfig": {
              "type": "nosql_kv",
              "config": {
                "consistency": "strong"
              }
            }
          }
        ]
      }
    },
    {
      "id": "payments",
      "desc": "A payment provider is integrated",
      "check": {
        "hasNode": "external_service"
      }
    },
    {
      "id": "idempotent-booking",
      "desc": "Booking/payment APIs are idempotent",
      "check": {
        "apiMatch": {
          "method": "POST",
          "idempotent": true
        }
      }
    },
    {
      "id": "spikes",
      "desc": "Traffic spikes are absorbed (queue, waiting room or rate limiting)",
      "check": {
        "anyOf": [
          {
            "hasNode": "queue"
          },
          {
            "hasNode": "rate_limiter"
          },
          {
            "mentions": "waiting room|virtual queue"
          }
        ]
      }
    },
    {
      "id": "booking-api",
      "desc": "An API books or holds seats",
      "check": {
        "apiMatch": {
          "method": "POST",
          "path~": "book|reserv|hold|seat"
        }
      }
    },
    {
      "id": "scale-out",
      "desc": "Every service sits behind a load balancer or API gateway",
      "check": {
        "upstreamOf": "service",
        "anyType": "entry"
      },
      "hint": "Put a load balancer or API gateway in front of your services so they can scale horizontally."
    }
  ],
  "references": [
    {
      "id": "redis-holds",
      "name": "Redis seat holds + SQL commit",
      "summary": "Selecting seats does SET seat:{show}:{seat} user NX EX 600 in Redis (atomic, auto-expiring hold). Checkout calls the payment provider with an idempotency key; on success a SQL transaction inserts bookings with UNIQUE(show_id, seat_id) as the final guard against double booking.",
      "tradeoffs": [
        "Fast holds without DB row locks",
        "Two sources of truth: Redis for holds, SQL for bookings",
        "Unique constraint catches any race Redis misses"
      ],
