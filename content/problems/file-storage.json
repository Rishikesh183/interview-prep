          },
          {
            "id": "e8",
            "source": "meta",
            "target": "q",
            "sourceHandle": "r",
            "targetHandle": "l",
            "protocol": "AMQP",
            "mode": "async"
          },
          {
            "id": "e9",
            "source": "q",
            "target": "notify",
            "sourceHandle": "r",
            "targetHandle": "l",
            "protocol": "AMQP",
            "mode": "async"
          }
        ]
      },
      "apis": [
        {
          "id": "a1",
          "ownerNodeId": "meta",
          "method": "POST",
          "path": "/v1/files/{path}/upload-session",
          "auth": true,
          "response": "{ missingBlocks: [{hash, presignedUrl}] }"
        },
        {
          "id": "a2",
          "ownerNodeId": "meta",
          "method": "POST",
          "path": "/v1/files/{path}/commit",
          "auth": true,
          "idempotent": true,
          "request": "{ blockHashes[], baseVersion }",
          "statusCodes": "200, 409"
        },
        {
          "id": "a3",
          "ownerNodeId": "meta",
          "method": "GET",
          "path": "/v1/changes",
          "auth": true,
          "pagination": "cursor"
        }
      ],
      "entities": [
        {
          "name": "FileVersion",
          "fields": "file_id, version, block_hashes[], size, modified_by"
        },
        {
          "name": "Block",
          "fields": "hash PK, size, s3_key, ref_count"
        }
      ]
    },
    {
      "id": "upload-service",
      "name": "Upload service streaming chunks",
      "summary": "Clients send resumable chunked uploads to an upload service that writes chunks to object storage and records them in metadata. Devices long-poll a changes endpoint for sync. Conflicts are resolved by keeping both versions.",
      "tradeoffs": [
        "Easier to validate and scan content",
        "Upload bandwidth flows through your fleet",
        "Long-polling is simpler than WebSockets but less instant"
      ],
