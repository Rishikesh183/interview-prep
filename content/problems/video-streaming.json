{
  "id": "video-streaming",
  "number": 21,
  "title": "YouTube / Netflix",
  "difficulty": "hard",
  "priority": true,
  "tags": ["transcoding", "cdn", "adaptive-bitrate", "object-storage"],
  "prompt": "Design a video platform like YouTube: creators upload videos, which are processed into multiple resolutions, and viewers around the world stream them smoothly on any device and network.",
  "functionalReqs": [
    "Upload videos (up to several GB)",
    "Transcode into multiple resolutions/formats",
    "Stream with adaptive bitrate",
    "Video metadata, search by title, view counts"
  ],
  "nonFunctionalReqs": [
    "Smooth playback worldwide (low startup time, minimal buffering)",
    "Uploads are durable and resumable",
    "Processing can take minutes; playback cannot lag",
    "Highly available reads"
  ],
  "scale": {
    "dau": "~1B daily views",
    "qps": "~500 hours of video uploaded per minute; ~100K concurrent stream starts/s at peak",
    "storage": "~1 GB per hour per rendition set → ~1 PB/day new storage",
    "notes": "Egress dominates cost: CDN is essential"
  },
  "outOfScope": ["Recommendations", "Comments", "Live streaming"],
  "hints": [
    "Transcoding a 2-hour 4K video takes a long time. Should the upload request wait?",
    "Serving bytes from your origin to a billion viewers is impossible. What sits in front?",
    "How does the player switch quality when the network gets worse?"
  ],
  "keyComponents": [
    "cdn",
    "object_storage",
    "message_queue",
    "worker",
    "service",
    "sql_db",
    "cache"
  ],
  "deepDives": [
    "Upload pipeline (resumable, presigned)",
    "Transcoding DAG and parallel chunk encoding",
    "HLS/DASH adaptive bitrate",
    "CDN strategy and cost"
  ],
  "rubricFocus": [
    "Async processing pipeline",
    "CDN delivery",
    "Adaptive streaming",
    "Storage layout"
  ],
  "tests": [
    {
      "id": "blob",
      "desc": "Raw and transcoded videos live in object storage",
      "check": {
        "hasNode": "object_storage"
      }
    },
    {
      "id": "cdn",
      "desc": "Viewers stream through a CDN",
      "check": {
        "pathExists": {
          "from": "client",
          "to": "cdn"
        }
      },
      "hint": "Clients should fetch video segments from a CDN, not your origin."
    },
    {
      "id": "async-transcode",
      "desc": "Transcoding runs asynchronously behind a queue",
      "check": {
        "allOf": [
          {
            "edgeMatch": {
              "to": "queue",
              "mode": "async"
            }
          },
          {
            "pathExists": {
              "from": "queue",
              "to": ["worker", "serverless_fn", "batch_processor"]
            }
          }
        ]
      }
    },
    {
      "id": "abr",
      "desc": "Adaptive bitrate streaming (HLS/DASH, multiple renditions)",
      "check": {
        "mentions": "adaptive|abr|hls|dash|bitrate|rendition"
      }
    },
    {
      "id": "metadata",
      "desc": "Video metadata is stored in a database",
      "check": {
        "hasNode": "db"
      }
    },
    {
      "id": "resumable",
      "desc": "Large uploads are resumable / direct to storage",
      "check": {
        "mentions": "presign|resum|chunk|multipart"
      }
    },
    {
      "id": "upload-api",
      "desc": "An API initiates uploads",
      "check": {
        "apiMatch": {
          "method": ["POST", "PUT"],
          "path~": "video|upload"
        }
      }
    },
    {
      "id": "watch-api",
      "desc": "An API returns playback info / manifest",
      "check": {
        "apiMatch": {
          "method": "GET",
          "path~": "video|watch|manifest|play"
        }
      }
    },
    {
      "id": "scale-out",
      "desc": "Every service sits behind a load balancer or API gateway",
      "check": {
        "upstreamOf": "service",
        "anyType": "entry"
      },
      "hint": "Put a load balancer or API gateway in front of your services so they can scale horizontally."
    }
  ],
  "references": [
    {
      "id": "queue-workers",
      "name": "Queue-driven transcoding workers",
      "summary": "Creators get a presigned multipart upload URL and upload straight to S3. The upload service records metadata and enqueues a transcode job. Workers split the video into segments, encode each segment into 240p–4K renditions in parallel, write HLS segments + manifests back to S3, and mark the video ready. Viewers fetch manifests and segments via the CDN; the player switches renditions (ABR).",
      "tradeoffs": [
        "Workers scale with queue depth",
        "Segment-level parallelism shortens processing",
        "Popular content is cached at the edge; long tail falls back to origin"
      ],
