      "id": "a2",
      "ownerNodeId": "trends",
      "method": "GET",
      "path": "/v1/trending",
      "request": "No request body; ?window=1h&limit=100",
      "response": "200 { \"items\": [], \"windowEnd\": 3600, \"approximate\": true }",
      "statusCodes": "200, 400",
      "auth": false,
      "idempotent": true,
      "note": "Expose window and approximation/freshness semantics; do not recompute a global sort on every query."
