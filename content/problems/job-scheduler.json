{
  "id": "job-scheduler",
  "number": 18,
  "title": "Distributed Job Scheduler",
  "difficulty": "medium",
  "tags": ["leader-election", "retries", "cron"],
  "prompt": "Design a distributed job scheduler (like a managed cron / Airflow lite) that runs millions of one-off and recurring jobs on time, with retries.",
  "functionalReqs": [
    "Schedule one-off and cron jobs",
    "Execute jobs on workers at the scheduled time",
    "Retries with backoff on failure",
    "Job status and history"
  ],
  "nonFunctionalReqs": [
    "Jobs run at least once, close to their scheduled time (< 1 s skew)",
    "No single point of failure",
    "Jobs are not run twice concurrently"
  ],
  "scale": {
    "qps": "~10K job executions/s peak",
    "storage": "~100M scheduled jobs"
  },
  "outOfScope": ["DAG dependencies between jobs"],
  "hints": [
    "Scanning 100M rows every second won't work. How do you find due jobs?",
    "Two scheduler instances must not both dispatch the same job.",
    "What if a worker dies mid-job?"
  ],
  "keyComponents": ["scheduler", "coordination", "sql_db", "message_queue", "worker"],
  "deepDives": [
    "Time-bucketed job tables",
    "Leader election vs partitioned schedulers",
    "Visibility timeouts and heartbeats",
    "Idempotent jobs"
  ],
  "rubricFocus": [
    "Finding due jobs efficiently",
    "Avoiding duplicate dispatch",
    "Failure recovery"
  ],
  "tests": [
    {
      "id": "job-store",
      "desc": "Jobs are stored durably",
      "check": {
        "hasNode": "db"
      }
    },
    {
      "id": "dispatch-queue",
      "desc": "Due jobs are dispatched to workers via a queue",
      "check": {
        "pathExists": {
          "from": "queue",
          "to": "worker"
        }
      }
    },
    {
      "id": "coordination",
      "desc": "Scheduler instances coordinate (leader election or partitioning)",
      "check": {
        "anyOf": [
          {
            "hasNode": "coordination"
          },
          {
            "mentions": "leader|partition|shard|lease"
          }
        ]
      }
    },
    {
      "id": "retries",
      "desc": "Failed jobs are retried with backoff",
      "check": {
        "mentions": "retr|backoff"
      }
    },
    {
      "id": "at-least-once",
      "desc": "Delivery semantics / idempotency are explained",
      "check": {
        "mentions": "idempot|at.?least.?once|exactly.?once|dedup"
      }
    },
    {
      "id": "worker-failure",
      "desc": "Worker crashes are detected (heartbeat/visibility timeout)",
      "check": {
        "mentions": "heartbeat|visibility|timeout|lease"
      }
    },
    {
      "id": "schedule-api",
      "desc": "An API schedules jobs",
      "check": {
        "apiMatch": {
          "method": "POST",
          "path~": "job|schedule"
        }
      }
    }
  ],
  "references": [
    {
      "id": "time-buckets",
      "name": "Time-bucketed table + partitioned schedulers",
      "summary": "Jobs are stored by next_run minute bucket and partition. Each scheduler owns partitions (leased via etcd), polls the current bucket, and pushes due jobs to SQS. Workers ack on completion; visibility timeout handles crashes.",
      "tradeoffs": ["Horizontally scalable", "Partition rebalancing complexity"],
      "graph": {
        "nodes": [
          {
            "id": "client",
            "type": "web_client",
            "position": {
