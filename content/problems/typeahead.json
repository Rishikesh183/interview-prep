{
  "id": "typeahead",
  "number": 11,
  "title": "Typeahead / Autocomplete",
  "difficulty": "medium",
  "tags": ["trie", "top-k", "caching"],
  "prompt": "Design search autocomplete: as a user types, show the top 5-10 suggested queries for the current prefix, ranked by popularity.",
  "functionalReqs": [
    "Return top-K suggestions for a prefix",
    "Suggestions reflect popularity, updated periodically",
    "Support multiple languages / regions"
  ],
  "nonFunctionalReqs": [
    "< 100 ms end-to-end, ideally < 20 ms server time",
    "Highly available",
    "Freshness within hours is fine"
  ],
  "scale": {
    "dau": "~100M DAU",
    "qps": "~10 searches/user/day × ~6 keystrokes → ~70K req/s avg",
    "storage": "~100M unique queries"
  },
  "outOfScope": ["Spell correction", "Personalization"],
  "hints": [
    "Every keystroke is a request. Where can you cut that down?",
    "Computing top-K at request time is too slow. Precompute it.",
    "How does a new trending query get into suggestions?"
  ],
  "keyComponents": ["cdn", "service", "cache", "event_stream", "batch_processor"],
  "deepDives": [
    "Trie with cached top-K per node",
    "Offline aggregation pipeline",
    "Sharding by prefix",
    "Client-side debouncing"
  ],
  "rubricFocus": ["Precomputed top-K", "Read path latency", "Data collection pipeline"],
  "tests": [
    {
      "id": "prefix-index",
      "desc": "Prefixes are served from a trie / prefix index",
      "check": {
        "mentions": "trie|prefix"
      }
    },
    {
      "id": "precompute",
      "desc": "Top-K is precomputed offline or in a stream",
      "check": {
        "anyOf": [
          {
            "hasNode": "batch_processor"
          },
          {
            "hasNode": "stream_processor"
          }
        ]
      }
    },
    {
      "id": "hot-cache",
      "desc": "Hot prefixes are cached (server or CDN)",
      "check": {
        "anyOf": [
          {
            "hasNode": "cache"
          },
          {
            "hasNode": "cdn"
          }
        ]
      }
    },
    {
      "id": "logging",
      "desc": "Search queries are collected for ranking",
      "check": {
        "anyOf": [
          {
            "edgeMatch": {
              "to": ["event_stream", "message_queue"]
            }
          },
          {
            "mentions": "query log|analytics log"
          }
        ]
      }
    },
    {
      "id": "api",
      "desc": "A suggestion API takes a prefix",
      "check": {
        "apiMatch": {
          "method": "GET",
          "path~": "suggest|complete|typeahead|search"
        }
      }
    },
    {
      "id": "client",
      "desc": "Client-side request reduction (debounce / browser cache)",
      "check": {
        "mentions": "debounc|throttl|browser cache|client.?side"
      }
    },
    {
      "id": "sharding",
      "desc": "Index sharding is addressed",
      "check": {
        "mentions": "shard|partition|replica"
      }
    },
    {
      "id": "scale-out",
      "desc": "Every service sits behind a load balancer or API gateway",
      "check": {
        "upstreamOf": "service",
        "anyType": "entry"
      },
      "hint": "Put a load balancer or API gateway in front of your services so they can scale horizontally."
    }
  ],
  "references": [
    {
      "id": "trie-batch",
      "name": "Trie with cached top-K + daily rebuild",
      "summary": "Query logs land in Kafka → S3; a daily Spark job aggregates counts and builds a trie where each node stores its top-10. Serialized tries are loaded into suggestion servers (sharded by first letters); responses cached at CDN with short TTL.",
      "tradeoffs": [
        "Very fast reads",
        "Up to a day stale; add a streaming layer for trending queries"
      ],
      "graph": {
        "nodes": [
          {
            "id": "client",
            "type": "web_client",
            "position": {
              "x": 0,
              "y": 0
            },
            "data": {
              "label": "Search box",
              "config": {},
              "note": "Debounce 150 ms; browser cache for repeated prefixes"
            }
          },
          {
            "id": "cdn",
            "type": "cdn",
            "position": {
              "x": 260,
              "y": 0
            },
            "data": {
              "label": "CDN",
              "config": {
                "content": ["api"],
                "ttl": "5m"
              }
            }
          },
          {
            "id": "lb",
            "type": "load_balancer",
            "position": {
              "x": 520,
              "y": 0
            },
            "data": {
              "label": "LB",
              "config": {
                "layer": "L7",
                "algorithm": "round-robin",
                "healthChecks": true
              }
            }
          },
          {
            "id": "svc",
