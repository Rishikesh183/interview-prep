  ],
  "apis": [
    {
      "id": "a1",
      "ownerNodeId": "api",
      "method": "POST",
      "path": "/v1/jobs",
      "request": "{ \"schedule\": \"0 * * * *\", \"timezone\": \"UTC\", \"payload\": {}, \"requestId\": \"r1\" }",
      "response": "201 { \"jobId\": \"j1\", \"nextRunAt\": \"...\" }",
      "statusCodes": "201, 400, 409",
      "auth": true,
      "idempotent": true,
      "note": "Validate timezone and missed-run policy; execution identity is job_id plus scheduled_at."
    },
    {
      "id": "a2",
      "ownerNodeId": "api",
      "method": "GET",
      "path": "/v1/jobs/{id}/executions",
      "request": "No request body; ?cursor=42",
      "response": "200 { \"executions\": [], \"nextCursor\": \"43\" }",
      "statusCodes": "200, 404",
      "auth": true,
      "idempotent": true,
      "pagination": "cursor",
      "note": "Separate the schedule from actual attempts so retries are observable."
    }
  ],
  "entities": [
    {
      "name": "Job",
      "fields": "job_id: string PK\nschedule: string\nnext_run_at: timestamp INDEX\npartition_id: int32\npayload: bytes\nversion: int64",
      "storeNodeId": "db"
    },
    {
      "name": "Execution",
      "fields": "execution_id: string PK\njob_id: string\nscheduled_at: timestamp\nstatus: QUEUED|RUNNING|SUCCEEDED|FAILED\nattempt: int32",
      "storeNodeId": "db"
    }
  ]
}
