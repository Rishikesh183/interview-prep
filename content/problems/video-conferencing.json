{
  "id": "video-conferencing",
  "number": 29,
  "title": "Video Conferencing (Zoom)",
  "difficulty": "hard",
  "tags": ["webrtc", "sfu", "real-time-media"],
  "prompt": "Design a video conferencing service like Zoom/Google Meet supporting meetings with up to 100 participants, screen sharing and recording.",
  "functionalReqs": [
    "Create/join meetings",
    "Multi-party audio/video",
    "Screen sharing",
    "Cloud recording",
    "Chat in meeting"
  ],
  "nonFunctionalReqs": [
    "< 150 ms media latency",
    "Adapts to poor networks",
    "Works behind NATs and firewalls",
    "Global users"
  ],
  "scale": {
    "dau": "~300M meeting participants/day",
    "qps": "~1M concurrent meetings at peak"
  },
  "outOfScope": ["Transcription", "Breakout rooms"],
  "hints": [
    "Mesh peer-to-peer breaks down past a handful of users. Why?",
    "SFU vs MCU: who mixes video, and what does that cost?",
    "How does media get through NAT?"
  ],
  "keyComponents": ["websocket_server", "service", "load_balancer", "object_storage", "sql_db"],
  "deepDives": [
    "Signaling vs media plane",
    "SFU with simulcast",
    "STUN/TURN",
    "Region selection",
    "Recording pipeline"
  ],
  "rubricFocus": ["Media architecture choice", "NAT traversal", "Scaling media servers"],
  "tests": [
    {
      "id": "signaling",
      "desc": "A signaling channel (WebSockets) sets up sessions",
      "check": {
        "hasNode": "websocket_server"
      }
    },
    {
      "id": "media-arch",
      "desc": "SFU or MCU media servers are chosen",
      "check": {
        "mentions": "\\bsfu\\b|\\bmcu\\b|selective forwarding|media server"
      }
    },
    {
      "id": "nat",
      "desc": "NAT traversal via STUN/TURN",
      "check": {
        "mentions": "stun|turn|ice|nat"
      }
    },
    {
      "id": "adaptive",
      "desc": "Quality adapts to bandwidth (simulcast/SVC)",
      "check": {
        "mentions": "simulcast|svc|adaptive|bandwidth"
      }
    },
    {
      "id": "recording",
      "desc": "Recordings are stored in object storage",
      "check": {
        "hasNode": "object_storage"
      }
    },
    {
      "id": "meeting-store",
      "desc": "Meetings and participants are stored",
      "check": {
        "hasNode": "db"
      }
    },
    {
      "id": "regions",
      "desc": "Users are routed to nearby media servers",
      "check": {
        "mentions": "region|geo|nearest|latency.?based"
      }
    },
    {
      "id": "join-api",
      "desc": "An API creates or joins meetings",
      "check": {
        "apiMatch": {
          "method": "POST",
          "path~": "meeting|room|join"
        }
      }
    }
  ],
  "references": [
    {
      "id": "sfu",
      "name": "SFU with simulcast",
      "summary": "Signaling over WebSockets; clients send 3 simulcast layers to a regional SFU which forwards the right layer to each receiver; STUN/TURN for NAT; recording bots join as participants and write to S3.",
      "tradeoffs": [
        "Server does no transcoding: cheap and low latency",
        "Clients decode many streams"
      ],
      "graph": {
        "nodes": [
          {
            "id": "client",
            "type": "web_client",
            "position": {
              "x": 0,
              "y": 0
            },
            "data": {
              "label": "Participants",
              "config": {},
              "note": "Sends 3 simulcast layers; adapts to bandwidth"
            }
          },
          {
            "id": "dns",
            "type": "dns",
            "position": {
              "x": 260,
              "y": 0
            },
            "data": {
              "label": "Geo DNS",
              "config": {
                "geoRouting": true
              },
              "note": "Routes to the nearest region"
            }
          },
          {
            "id": "lb",
            "type": "load_balancer",
            "position": {
              "x": 260,
              "y": 130
            },
            "data": {
              "label": "Signaling LB",
              "config": {
                "layer": "L7",
                "algorithm": "consistent-hash",
                "healthChecks": true
              },
              "note": "By meeting id"
            }
          },
          {
            "id": "sig",
            "type": "websocket_server",
            "position": {
              "x": 520,
              "y": 0
            },
            "data": {
              "label": "Signaling",
              "config": {
                "instances": 6,
                "stickySessions": true,
                "connectionsPerNode": 50000
              }
            }
          },
          {
            "id": "meet",
            "type": "service",
            "position": {
              "x": 520,
              "y": 130
            },
            "data": {
              "label": "Meeting Service",
              "config": {
                "stateless": true,
                "instancesMin": 2,
                "instancesMax": 10,
                "autoscale": true,
                "language": ""
