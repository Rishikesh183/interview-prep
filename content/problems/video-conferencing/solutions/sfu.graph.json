  "apis": [
    {
      "id": "a1",
      "ownerNodeId": "meet",
      "method": "POST",
      "path": "/v1/meetings",
      "request": "{ \"requestId\": \"r1\", \"recordingEnabled\": false }",
      "response": "201 { \"meetingId\": \"m1\", \"joinUrl\": \"https://meet/m1\" }",
      "statusCodes": "201, 400",
      "auth": true,
      "idempotent": true,
      "note": "Recording permissions and retention are explicit; allocate a nearby media region."
    },
    {
      "id": "a2",
      "ownerNodeId": "meet",
      "method": "POST",
      "path": "/v1/meetings/{id}/join",
      "request": "{ \"participantId\": \"u1\", \"capabilities\": [\"simulcast\"] }",
      "response": "200 { \"token\": \"short-lived\", \"mediaRegion\": \"ap-south\", \"iceServers\": [] }",
      "statusCodes": "200, 403, 404",
      "auth": true,
      "note": "Signaling exchanges SDP/ICE over WebSockets; RTP media goes to SFU/MCU or TURN, independently of the API."
    },
    {
      "id": "a3",
      "ownerNodeId": "sig",
      "method": "WS",
      "path": "/v1/meetings/{id}/signal",
      "request": "{ \"type\": \"offer\", \"sdp\": \"...\" }; { \"type\": \"ice\", \"candidate\": \"...\" }",
      "response": "{ \"type\": \"answer\", \"sdp\": \"...\" }; participant events",
      "statusCodes": "101; forbidden, session_expired",
      "auth": true,
      "note": "Use ICE with STUN/TURN; WebSocket signaling does not carry the video media stream."
    }
  ],
  "entities": [
    {
      "name": "Meeting",
      "fields": "meeting_id: string PK\nhost_id: string\nregion: string\nparticipant_ids: string[]\nstatus: ACTIVE|ENDED\nrecording_key: string?",
      "storeNodeId": "db"
    }
  ]
}
