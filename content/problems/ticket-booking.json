          "request": "{ seatIds[] }",
          "statusCodes": "201, 409",
          "idempotent": true
        },
        {
          "id": "a2",
          "ownerNodeId": "svc",
          "method": "POST",
          "path": "/v1/bookings",
          "auth": true,
          "request": "{ holdId, paymentToken }",
          "idempotent": true,
          "statusCodes": "201, 402, 409, 410"
        }
      ],
      "entities": [
        {
          "name": "Booking",
          "fields": "id, show_id, seat_id, user_id, status, payment_id — UNIQUE(show_id, seat_id)"
        },
        {
          "name": "Show",
          "fields": "id, venue_id, starts_at"
        }
      ]
    },
    {
      "id": "db-row-locks",
      "name": "Database row locks + waiting room",
      "summary": "Seats are rows with status. Holding runs SELECT ... FOR UPDATE then sets status=HELD with held_until. A sweeper job releases expired holds. For hot shows a virtual waiting room (queue) admits users in batches so the DB isn't overwhelmed.",
      "tradeoffs": [
        "Single source of truth",
        "Row locks limit throughput on hot shows",
        "Waiting room gives fairness"
      ],
