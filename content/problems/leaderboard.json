{
  "id": "leaderboard",
  "number": 6,
  "title": "Real-time Leaderboard",
  "difficulty": "easy",
  "tags": ["redis", "sorted-sets", "sharding"],
  "prompt": "Design a real-time leaderboard for an online game with millions of players. Players' scores change as they play; anyone can see the top 100 and their own rank.",
  "functionalReqs": [
    "Update a player's score",
    "Get the top N players",
    "Get a player's rank and nearby players",
    "Daily / all-time leaderboards"
  ],
  "nonFunctionalReqs": [
    "Rank updates visible within seconds",
    "Top-N reads < 50 ms",
    "Durable scores"
  ],
  "scale": {
    "dau": "~25M DAU",
    "qps": "~50K score updates/s peak, ~100K reads/s",
    "storage": "~100 B per player per board"
  },
  "outOfScope": ["Anti-cheat", "Matchmaking"],
  "hints": [
    "Which data structure gives O(log n) rank lookups?",
    "One sorted set with 100M members is big. How would you shard and still answer 'top 100'?",
    "What is the source of truth if the cache is lost?"
  ],
  "keyComponents": ["service", "cache", "sql_db", "event_stream"],
  "deepDives": [
    "Redis sorted sets (ZINCRBY / ZREVRANK)",
    "Sharding by score range vs by user",
    "Rebuilding from durable storage"
  ],
  "rubricFocus": ["Right data structure", "Sharding strategy", "Durability"],
  "tests": [
    {
      "id": "sorted-set",
      "desc": "Ranks come from a sorted structure (e.g. Redis ZSET)",
      "check": {
        "mentions": "sorted.?set|zset|zadd|zincrby|zrevrank|skip.?list"
      }
    },
    {
      "id": "cache",
      "desc": "Leaderboards are served from memory",
      "check": {
        "hasNode": "cache"
      }
    },
    {
      "id": "durable",
      "desc": "Scores are persisted durably",
      "check": {
        "hasNode": "db"
      }
    },
    {
      "id": "top-api",
      "desc": "An API returns the top players",
      "check": {
        "apiMatch": {
          "method": "GET",
          "path~": "top|leaderboard|rank"
        }
      }
    },
    {
      "id": "score-api",
      "desc": "An API updates scores",
      "check": {
        "apiMatch": {
          "method": ["POST", "PUT", "PATCH"],
          "path~": "score"
        }
      }
    },
    {
      "id": "sharding",
      "desc": "Scaling past one node is addressed",
      "check": {
        "mentions": "shard|partition|bucket"
      }
    },
    {
      "id": "scale-out",
      "desc": "Every service sits behind a load balancer or API gateway",
      "check": {
        "upstreamOf": "service",
        "anyType": "entry"
      },
      "hint": "Put a load balancer or API gateway in front of your services so they can scale horizontally."
    }
  ],
  "references": [
    {
      "id": "single-zset",
      "name": "Redis sorted set + DB of record",
      "summary": "Score updates go to SQL (source of truth) and ZINCRBY on Redis. Top-N via ZREVRANGE, own rank via ZREVRANK. Daily boards are separate keys with TTL.",
      "tradeoffs": ["Simple, very fast up to ~100M members per shard", "Redis memory is the limit"],
      "graph": {
        "nodes": [
          {
            "id": "client",
            "type": "mobile_client",
            "position": {
              "x": 0,
              "y": 0
            },
            "data": {
              "label": "Game client",
              "config": {}
            }
          },
          {
            "id": "lb",
            "type": "load_balancer",
            "position": {
              "x": 260,
              "y": 0
            },
            "data": {
              "label": "LB",
              "config": {
                "layer": "L7",
                "algorithm": "round-robin",
                "healthChecks": true
              }
            }
          },
          {
            "id": "svc",
            "type": "service",
            "position": {
              "x": 520,
              "y": 0
            },
            "data": {
              "label": "Leaderboard Service",
              "config": {
                "stateless": true,
                "instancesMin": 2,
                "instancesMax": 10,
                "autoscale": true,
                "language": ""
              },
              "note": "ZINCRBY on score updates; ZREVRANGE for top 100; ZREVRANK for own rank"
            }
          },
          {
            "id": "redis",
            "type": "cache",
            "position": {
              "x": 780,
              "y": 0
            },
            "data": {
              "label": "Redis sorted sets",
              "config": {
                "engine": "Redis",
                "strategy": "write-through",
                "eviction": "LRU",
                "ttl": "24h",
                "cluster": true
              },
              "note": "One ZSET per board; shard by score bucket past ~100M members"
            }
          },
          {
            "id": "db",
            "type": "sql_db",
            "position": {
              "x": 780,
              "y": 130
            },
            "data": {
              "label": "Scores DB",
              "config": {
                "engine": "PostgreSQL",
                "replicas": 2,
                "readReplicas": false,
                "sharding": "none",
                "shardKey": ""
              },
              "note": "Source of truth; rebuild ZSETs from here"
            }
          }
        ],
        "edges": [
          {
            "id": "e1",
            "source": "client",
            "target": "lb",
            "sourceHandle": "r",
            "targetHandle": "l",
            "protocol": "HTTP",
            "mode": "sync"
          },
          {
            "id": "e2",
            "source": "lb",
            "target": "svc",
            "sourceHandle": "r",
            "targetHandle": "l",
            "protocol": "HTTP",
            "mode": "sync"
          },
          {
            "id": "e3",
            "source": "svc",
            "target": "redis",
            "sourceHandle": "r",
            "targetHandle": "l",
            "protocol": "TCP",
            "mode": "sync",
            "op": "read_write"
          },
          {
            "id": "e4",
            "source": "svc",
