{
  "id": "news-feed",
  "number": 8,
  "title": "News Feed (Twitter)",
  "difficulty": "medium",
  "priority": true,
  "tags": ["fan-out", "caching", "celebrity-problem", "read-heavy"],
  "prompt": "Design the home timeline for a Twitter-like service. Users post short text (with optional images) and follow other users. The home feed shows recent posts from people they follow.",
  "functionalReqs": [
    "Create a post (text + optional media)",
    "Follow / unfollow users",
    "View home timeline (reverse chronological, paginated)",
    "View a user's own posts"
  ],
  "nonFunctionalReqs": [
    "Timeline loads in < 200 ms p99",
    "Eventual consistency OK: a post may take a few seconds to show up",
    "Highly available"
  ],
  "scale": {
    "dau": "~200M DAU",
    "qps": "~5 timeline reads/user/day → ~12K reads/s avg; ~500M posts/day → ~6K writes/s",
    "storage": "~300 B per post → ~150 GB/day (media separate)",
    "notes": "Average 200 followers; some accounts have 100M+"
  },
  "outOfScope": ["Ranking ML models", "Ads", "Search"],
  "hints": [
    "Push (fan-out on write) makes reads cheap. What does it cost for an account with 100M followers?",
    "Pull (fan-out on read) makes writes cheap. What does it cost on every timeline load?",
    "Can you mix the two?"
  ],
  "keyComponents": [
    "load_balancer",
    "service",
    "cache",
    "event_stream",
    "worker",
    "nosql_kv",
    "object_storage",
    "cdn"
  ],
  "deepDives": [
    "Fan-out on write vs read vs hybrid",
    "Celebrity problem",
    "Timeline cache sizing",
    "Media delivery"
  ],
  "rubricFocus": ["Fan-out strategy with trade-offs", "Timeline caching", "Handling celebrities"],
  "tests": [
    {
      "id": "post-store",
      "desc": "Posts are stored durably",
      "check": {
        "pathExists": {
          "from": "client",
          "to": "db"
        }
      }
    },
    {
      "id": "timeline-cache",
      "desc": "Timelines or recent posts are served from a cache",
      "check": {
        "hasNode": "cache"
      }
    },
    {
      "id": "media",
      "desc": "Media is served from object storage / CDN",
      "check": {
        "anyOf": [
          {
            "hasNode": "cdn"
          },
          {
            "hasNode": "object_storage"
          }
        ]
      }
    },
    {
      "id": "celebrity",
      "desc": "The celebrity (huge follower count) case is handled",
      "check": {
        "mentions": "celebrit|hybrid|high.?follower|fan.?out on read|pull model"
      },
      "hint": "Explain what happens when an account with 100M followers posts."
    },
    {
      "id": "follow-graph",
      "desc": "The follow graph is modelled",
      "check": {
        "anyOf": [
          {
            "entityMatch": {
              "name~": "follow"
            }
          },
          {
            "mentions": "follow"
          }
        ]
      }
    },
    {
      "id": "feed-api",
      "desc": "The timeline API uses cursor pagination",
      "check": {
        "apiMatch": {
          "method": "GET",
          "path~": "feed|timeline|home",
          "pagination": "cursor"
        }
      }
    },
    {
      "id": "post-api",
      "desc": "An API creates posts",
      "check": {
        "apiMatch": {
          "method": "POST",
          "path~": "post|tweet|status"
        }
      }
    },
    {
      "id": "scale-out",
      "desc": "Every service sits behind a load balancer or API gateway",
      "check": {
        "upstreamOf": "service",
        "anyType": "entry"
      },
      "hint": "Put a load balancer or API gateway in front of your services so they can scale horizontally."
    }
  ],
  "references": [
    {
      "id": "hybrid-push",
      "name": "Fan-out on write (hybrid for celebrities)",
      "summary": "Post Service stores the post and emits an event. Fan-out workers push the post ID into each follower's timeline list in Redis (capped at ~800 IDs). Accounts above ~10K followers are skipped; their posts are merged in at read time (hybrid).",
      "tradeoffs": [
        "Timeline reads are a single Redis lookup",
        "Write amplification: avg 200 cache writes per post",
        "Hybrid merge adds read-time work only for celebrity followees"
      ],
