    {
      "id": "single-leader",
      "name": "Single leader with hot standby",
      "summary": "One leader (elected via ZooKeeper) scans a min-heap/ordered index of next_run and dispatches; standby takes over on failure.",
      "tradeoffs": ["Simple", "Leader throughput caps the system"]
    }
  ]
}
