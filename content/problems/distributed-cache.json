              "y": 0
            },
            "data": {
              "label": "App servers",
              "config": {
                "stateless": true,
                "instancesMin": 2,
                "instancesMax": 10,
                "autoscale": true,
                "language": ""
              },
              "note": "Smart client library holds the consistent hashing ring (150 virtual nodes per server); local near cache for hot keys"
            }
          },
          {
            "id": "cache",
            "type": "cache",
            "position": {
              "x": 780,
              "y": 0
            },
            "data": {
              "label": "Cache cluster",
              "config": {
                "engine": "Redis",
                "strategy": "cache-aside",
                "eviction": "LRU",
                "ttl": "1h",
                "cluster": true
              },
              "note": "Each key also written to the next node on the ring (replica) for failover"
            }
          },
          {
