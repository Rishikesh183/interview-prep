              "config": {
                "layer": "L7",
                "algorithm": "least-conn",
                "healthChecks": true
              }
            }
          },
          {
            "id": "svc",
            "type": "service",
            "position": {
              "x": 520,
              "y": 0
            },
            "data": {
              "label": "URL Service",
              "config": {
                "stateless": true,
                "instancesMin": 3,
                "instancesMax": 20,
                "autoscale": true,
                "language": ""
              },
              "note": "Base62-encodes IDs; returns 302 so we can add analytics later"
            }
          },
          {
            "id": "idgen",
            "type": "id_generator",
            "position": {
              "x": 780,
              "y": 0
            },
            "data": {
              "label": "ID Generator",
              "config": {
                "strategy": "base62-counter"
              },
              "note": "Hands out ID ranges of 1000 per server"
            }
          },
          {
            "id": "cache",
            "type": "cache",
            "position": {
              "x": 780,
              "y": 130
            },
            "data": {
              "label": "Redis",
              "config": {
                "engine": "Redis",
                "strategy": "cache-aside",
                "eviction": "LRU",
                "ttl": "24h",
                "cluster": true
              },
              "note": "Hot mappings, ~20% of daily reads"
            }
          },
          {
            "id": "db",
            "type": "nosql_kv",
            "position": {
              "x": 780,
              "y": 260
            },
            "data": {
              "label": "URL Store",
              "config": {
                "engine": "DynamoDB",
                "partitionKey": "code",
                "sortKey": "",
                "consistency": "eventual"
              }
            }
          }
        ],
        "edges": [
          {
            "id": "e1",
            "source": "client",
            "target": "lb",
            "sourceHandle": "r",
            "targetHandle": "l",
            "protocol": "HTTP",
            "mode": "sync"
          },
          {
            "id": "e2",
            "source": "lb",
            "target": "svc",
            "sourceHandle": "r",
            "targetHandle": "l",
            "protocol": "HTTP",
            "mode": "sync"
          },
          {
            "id": "e3",
            "source": "svc",
            "target": "idgen",
            "sourceHandle": "r",
            "targetHandle": "l",
            "protocol": "HTTP",
            "mode": "sync",
            "op": "read",
            "label": "get ID range"
          },
          {
            "id": "e4",
            "source": "svc",
            "target": "cache",
            "sourceHandle": "r",
            "targetHandle": "l",
            "protocol": "TCP",
            "mode": "sync",
            "op": "read_write"
          },
          {
            "id": "e5",
            "source": "svc",
            "target": "db",
            "sourceHandle": "r",
            "targetHandle": "l",
            "protocol": "TCP",
            "mode": "sync",
            "op": "read_write",
            "label": "insert / lookup mapping"
          }
        ]
      },
      "apis": [
        {
          "id": "a1",
          "ownerNodeId": "svc",
          "method": "POST",
          "path": "/v1/urls",
          "auth": true,
          "request": "{ longUrl, alias?, expiresAt? }",
          "response": "{ code, shortUrl }",
          "statusCodes": "201, 400, 409",
          "idempotent": false,
          "rateLimited": true
        },
        {
          "id": "a2",
          "ownerNodeId": "svc",
          "method": "GET",
          "path": "/{code}",
          "auth": false,
          "response": "302 Location: longUrl",
          "statusCodes": "302, 404, 410"
        }
      ],
      "entities": [
        {
          "name": "UrlMapping",
          "fields": "code (PK), long_url, created_at, expires_at, owner_id"
        }
      ]
    },
    {
      "id": "hash-collision",
      "name": "Hash + collision check",
      "summary": "The service hashes the long URL (MD5/SHA-256), takes the first 7 base62 characters and inserts with a unique constraint. On collision it appends a salt and retries. Same long URL maps to the same code, which deduplicates for free.",
      "tradeoffs": [
        "No coordination service needed",
        "Collisions grow with table size; each retry costs a DB round trip",
        "Deterministic codes leak whether a URL was already shortened"
      ],
