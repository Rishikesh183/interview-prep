  "apis": [
    {
      "id": "a1",
      "ownerNodeId": "ingest",
      "method": "POST",
      "path": "/v1/events",
      "request": "{ \"eventId\": \"e1\", \"itemId\": \"i1\", \"occurredAt\": 1 }",
      "response": "202 { \"accepted\": true }",
      "statusCodes": "202, 400, 429",
      "auth": true,
      "idempotent": true,
      "note": "Dedup event IDs within the policy window; separate event time from processing time."
    },
