          "response": "ack {messageId, seq}"
        },
        {
          "id": "a2",
          "ownerNodeId": "hist",
          "method": "GET",
          "path": "/v1/conversations/{id}/messages",
          "auth": true,
          "pagination": "cursor",
          "response": "{ messages, nextCursor }"
        }
      ],
      "entities": [
        {
          "name": "Message",
          "fields": "conversation_id (partition), message_id (clustering, snowflake), sender_id, body, status"
        },
        {
          "name": "Conversation",
          "fields": "id, members[], type (direct/group)"
        }
      ]
    },
    {
      "id": "kafka-fanout",
      "name": "Kafka-backed delivery",
      "summary": "Chat servers append every message to Kafka partitioned by conversation_id (ordering per partition). Delivery workers consume, persist to storage and route to the recipient's chat server via a session registry; offline recipients get a push.",
      "tradeoffs": [
        "Durable, replayable log; consumers can be added (search, analytics)",
        "Higher latency than direct pub/sub",
        "Session registry must be kept fresh on reconnects"
      ],
