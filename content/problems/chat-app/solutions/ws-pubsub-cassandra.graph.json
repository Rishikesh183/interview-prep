  "apis": [
    {
      "id": "a1",
      "ownerNodeId": "ws",
      "method": "WS",
      "path": "/v1/connect",
      "request": "{ \"type\": \"send\", \"conversationId\": \"c1\", \"messageId\": \"client-42\", \"body\": \"hello\" }",
      "response": "{ \"type\": \"ack\", \"messageId\": \"client-42\", \"sequence\": 18 }; { \"type\": \"message\", \"sequence\": 18, \"body\": \"hello\" }",
      "statusCodes": "101; invalid_message, forbidden, unavailable",
      "auth": true,
      "idempotent": true,
      "note": "Dedup by messageId; distinguish durable acceptance, recipient delivery and read receipts. Reconnect resumes from the last acknowledged sequence."
    },
    {
      "id": "a2",
      "ownerNodeId": "hist",
      "method": "GET",
      "path": "/v1/conversations/{id}/messages",
      "request": "No request body; ?afterSequence=17&limit=50",
      "response": "200 { \"messages\": [{ \"sequence\": 18, \"body\": \"hello\" }], \"nextCursor\": \"18\" }",
      "statusCodes": "200, 401, 403",
      "auth": true,
      "idempotent": true,
      "pagination": "cursor",
      "note": "Use cursor pagination over conversation sequence, never a global ordering requirement."
    }
  ],
  "entities": [
    {
      "name": "Message",
      "fields": "conversation_id: string partition key\nsequence: int64 sort key\nmessage_id: string UNIQUE\nsender_id: string\nbody: string\ncreated_at: timestamp",
      "storeNodeId": "cass"
    },
    {
      "name": "Conversation",
      "fields": "conversation_id: string PK\nmember_ids: string[]\nlast_sequence: int64",
      "storeNodeId": "cass"
    }
  ]
