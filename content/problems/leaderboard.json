      },
      "apis": [
        {
          "id": "a1",
          "ownerNodeId": "svc",
          "method": "POST",
          "path": "/v1/scores",
          "auth": true,
          "idempotent": true,
          "request": "{ playerId, delta, matchId }"
        },
        {
          "id": "a2",
          "ownerNodeId": "svc",
          "method": "GET",
          "path": "/v1/leaderboards/{board}/top",
          "auth": false,
          "pagination": "offset"
        },
        {
          "id": "a3",
          "ownerNodeId": "svc",
          "method": "GET",
          "path": "/v1/leaderboards/{board}/rank/{playerId}",
          "auth": true
        }
      ],
      "entities": []
    },
    {
      "id": "sharded-buckets",
      "name": "Score-range shards + stream",
      "summary": "Updates flow through Kafka; consumers write to shards bucketed by score range so top-N only reads the highest shard; ranks = sum of counts in higher shards + local rank.",
      "tradeoffs": ["Scales writes horizontally", "Players move between shards as scores change"]
    }
  ]
}
