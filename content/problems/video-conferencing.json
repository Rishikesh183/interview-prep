          },
          {
            "id": "mlb",
            "type": "load_balancer",
            "position": {
              "x": 260,
              "y": 260
            },
            "data": {
              "label": "Media LB",
              "config": {
                "layer": "L4",
                "algorithm": "round-robin",
                "healthChecks": true
              }
            }
          },
          {
            "id": "sfu",
            "type": "service",
            "position": {
              "x": 520,
              "y": 260
