{
  "id": "distributed-kv-store",
  "number": 25,
  "title": "Distributed KV Store",
  "difficulty": "hard",
  "tags": ["consistent-hashing", "replication", "quorum", "gossip"],
  "prompt": "Design a distributed key-value store like Dynamo/Cassandra: put(key, value) and get(key), scaled across hundreds of nodes, tunable consistency, always writable.",
  "functionalReqs": [
    "put(key, value), get(key)",
    "Tunable consistency per request",
    "Add/remove nodes online"
  ],
  "nonFunctionalReqs": [
    "Highly available for writes, even during partitions",
    "Scales linearly",
    "Low latency (< 10 ms p99)"
  ],
  "scale": {
    "qps": "~1M ops/s",
    "storage": "~1 PB, values up to 1 MB"
  },
  "outOfScope": ["Secondary indexes", "Transactions across keys"],
  "hints": [
    "How is the key space split and rebalanced?",
    "With N replicas, how many must answer a read or write?",
    "Two replicas have different values for a key. Which one wins?"
  ],
  "keyComponents": ["service", "nosql_kv", "coordination"],
  "deepDives": [
    "Consistent hashing + virtual nodes",
    "Quorum N/R/W",
    "Vector clocks vs LWW",
    "Hinted handoff, read repair, Merkle trees",
    "Gossip membership"
  ],
  "rubricFocus": [
    "Partitioning",
    "Replication & quorum",
    "Conflict resolution",
    "Failure handling"
  ],
  "tests": [
    {
      "id": "partitioning",
      "desc": "Keys are partitioned with consistent hashing",
      "check": {
        "mentions": "consistent.?hash|hash.?ring|virtual.?node|vnode"
      }
    },
    {
      "id": "replication",
      "desc": "Each key is replicated to N nodes",
      "check": {
        "mentions": "replica|replicat"
      }
    },
    {
      "id": "quorum",
      "desc": "Reads/writes use tunable quorums",
      "check": {
        "mentions": "quorum|\\bR\\s*\\+\\s*W|N/R/W"
      }
    },
    {
      "id": "conflicts",
      "desc": "Conflicting versions are resolved",
      "check": {
        "mentions": "vector clock|last.?write|lww|sibling|version"
      }
    },
    {
      "id": "membership",
      "desc": "Membership and failure detection (gossip)",
      "check": {
        "anyOf": [
          {
            "mentions": "gossip"
          },
          {
            "hasNode": "coordination"
          }
        ]
      }
    },
    {
      "id": "repair",
      "desc": "Replicas repair divergence (hinted handoff / read repair / Merkle)",
      "check": {
        "mentions": "hinted|read.?repair|merkle|anti.?entropy"
      }
    },
    {
      "id": "storage-nodes",
      "desc": "Storage nodes exist",
      "check": {
        "hasNode": ["nosql_kv", "wide_column"]
      }
    },
    {
      "id": "api",
      "desc": "get/put APIs exist",
      "check": {
        "allOf": [
          {
            "apiMatch": {
              "method": "GET"
            }
          },
          {
            "apiMatch": {
              "method": ["PUT", "POST"]
            }
          }
        ]
      }
    }
  ],
  "references": [
    {
      "id": "dynamo",
      "name": "Dynamo-style leaderless",
      "summary": "Consistent hashing with vnodes; any node coordinates; N=3, W=2, R=2; vector clocks with client-side merge; hinted handoff, read repair and Merkle-tree anti-entropy; gossip for membership.",
      "tradeoffs": ["Always writable", "Clients may see siblings"],
      "graph": {
        "nodes": [
          {
            "id": "client",
            "type": "web_client",
            "position": {
              "x": 0,
              "y": 0
            },
            "data": {
              "label": "Clients",
              "config": {}
            }
          },
          {
            "id": "lb",
            "type": "load_balancer",
            "position": {
              "x": 260,
              "y": 0
            },
            "data": {
              "label": "LB",
              "config": {
                "layer": "L7",
                "algorithm": "round-robin",
                "healthChecks": true
              }
            }
          },
          {
            "id": "coord",
            "type": "service",
            "position": {
              "x": 520,
              "y": 0
            },
            "data": {
              "label": "Coordinator nodes",
              "config": {
                "stateless": true,
                "instancesMin": 2,
                "instancesMax": 10,
                "autoscale": true,
                "language": ""
              },
              "note": "Any node coordinates: consistent hashing with vnodes; N=3, W=2, R=2 quorum; vector clocks; hinted handoff, read repair, Merkle anti-entropy; gossip membership"
            }
          },
          {
            "id": "store",
            "type": "nosql_kv",
            "position": {
              "x": 780,
              "y": 0
            },
            "data": {
              "label": "Storage nodes",
              "config": {
                "engine": "DynamoDB",
                "partitionKey": "key",
                "sortKey": "",
                "consistency": "eventual"
              },
              "note": "Each key replicated to the next N-1 nodes on the ring"
            }
          }
        ],
        "edges": [
          {
            "id": "e1",
            "source": "client",
            "target": "lb",
            "sourceHandle": "r",
            "targetHandle": "l",
            "protocol": "HTTP",
            "mode": "sync"
          },
          {
            "id": "e2",
            "source": "lb",
            "target": "coord",
            "sourceHandle": "r",
            "targetHandle": "l",
            "protocol": "HTTP",
            "mode": "sync"
          },
          {
            "id": "e3",
            "source": "coord",
            "target": "store",
            "sourceHandle": "r",
            "targetHandle": "l",
            "protocol": "TCP",
            "mode": "sync",
            "op": "read_write"
          }
        ]
      },
      "apis": [
        {
          "id": "a1",
          "ownerNodeId": "coord",
          "method": "GET",
          "path": "/v1/kv/{key}",
          "auth": true
        },
        {
          "id": "a2",
          "ownerNodeId": "coord",
          "method": "PUT",
          "path": "/v1/kv/{key}",
          "auth": true,
          "idempotent": true
        }
      ],
      "entities": []
    },
    {
      "id": "leader-per-range",
      "name": "Leader per range (Raft)",
      "summary": "Key ranges are split into Raft groups; leader handles writes; ranges split/merge and rebalance automatically; metadata in an etcd-like store.",
      "tradeoffs": ["Strong consistency per key", "Unavailable for a range during leader election"]
    }
  ]
}
