          "ownerNodeId": "search",
          "method": "GET",
          "path": "/v1/search/nearby",
          "auth": false,
          "pagination": "cursor",
          "request": "?lat&lng&radius"
        },
        {
          "id": "a2",
          "ownerNodeId": "biz",
          "method": "POST",
          "path": "/v1/businesses",
          "auth": true
        }
      ],
      "entities": []
    },
    {
      "id": "quadtree",
      "name": "In-memory quadtree",
      "summary": "Each search server builds an in-memory quadtree (leaf ≤ 100 businesses) at startup from the DB; rebuilt nightly with rolling restarts.",
      "tradeoffs": ["Adapts to density", "Startup build time; memory per server (~2 GB)"]
    }
  ]
}
