{
  "id": "ride-sharing",
  "number": 22,
  "title": "Uber / Ola",
  "difficulty": "hard",
  "priority": true,
  "tags": ["geo-index", "high-write-qps", "matching", "consistency"],
  "prompt": "Design a ride-hailing service like Uber. Drivers continuously report their location; riders request a ride and get matched with a nearby available driver; both see each other's live location during the trip.",
  "functionalReqs": [
    "Drivers send location every few seconds",
    "Riders see nearby drivers and request a ride",
    "Match rider with a nearby available driver",
    "Live trip tracking and fare/payment at the end"
  ],
  "nonFunctionalReqs": [
    "Matching within seconds",
    "A driver is never assigned to two riders",
    "Location ingestion handles very high write QPS",
    "Highly available in each city"
  ],
  "scale": {
    "dau": "~20M riders/day, ~5M active drivers",
    "qps": "Drivers send location every 4 s → ~1.25M location writes/s",
    "storage": "Live locations are small (in-memory); trip history ~1 KB per trip"
  },
  "outOfScope": ["Surge pricing models", "ETA ML", "Driver onboarding"],
  "hints": [
    "1M+ location writes per second into a relational DB is painful. Do you need durability for every ping?",
    "Find drivers within 2 km quickly: what index?",
    "Two riders' requests race for the same driver. How do you make the assignment atomic?"
  ],
  "keyComponents": [
    "load_balancer",
    "websocket_server",
    "geo_index",
    "cache",
    "service",
    "sql_db",
    "external_service"
  ],
  "deepDives": [
    "Geo indexing (geohash/S2/H3) and sharding by region",
    "Location ingestion path",
    "Atomic driver assignment",
    "Trip state machine"
  ],
  "rubricFocus": ["Handling location write load", "Spatial lookup", "Consistent matching"],
  "tests": [
    {
      "id": "location-ingest",
      "desc": "Driver locations stream in over persistent connections or a stream",
      "check": {
        "anyOf": [
          {
            "hasNode": "websocket_server"
          },
          {
            "edgeMatch": {
              "to": "event_stream"
            }
          }
        ]
      }
    },
    {
      "id": "geo",
      "desc": "A spatial index finds nearby drivers",
      "check": {
        "anyOf": [
          {
            "hasNode": "geo_index"
          },
          {
            "mentions": "geohash|quadtree|\\bs2\\b|\\bh3\\b|geosearch|georadius"
          }
        ]
      }
    },
    {
      "id": "hot-writes",
      "desc": "Hot location writes avoid the primary transactional DB",
      "check": {
        "anyOf": [
          {
            "edgeMatch": {
              "to": "cache"
            }
          },
          {
            "edgeMatch": {
              "to": "geo_index"
            }
          },
          {
            "edgeMatch": {
              "to": "event_stream"
            }
          }
        ]
      }
    },
    {
      "id": "matching",
      "desc": "A matching / dispatch service exists",
      "check": {
        "nodeConfig": {
          "type": "service",
          "text~": "match|dispatch"
        }
      }
    },
    {
      "id": "trip-store",
      "desc": "Trips are stored durably",
      "check": {
        "hasNode": "db"
      }
    },
    {
      "id": "atomic-assign",
      "desc": "A driver can only be assigned once",
      "check": {
        "mentions": "lock|atomic|compare.?and|cas|transaction|exactly one|setnx|conditional"
      }
    },
    {
      "id": "payments",
      "desc": "Payment provider is integrated",
      "check": {
        "hasNode": "external_service"
      }
    },
    {
      "id": "ride-api",
      "desc": "An API requests a ride",
      "check": {
        "apiMatch": {
          "method": "POST",
          "path~": "ride|trip"
        }
      }
    },
    {
      "id": "scale-out",
      "desc": "Every service sits behind a load balancer or API gateway",
      "check": {
        "upstreamOf": "service",
        "anyType": "entry"
      },
      "hint": "Put a load balancer or API gateway in front of your services so they can scale horizontally."
    }
  ],
  "references": [
    {
      "id": "ws-redis-geo",
      "name": "WebSockets + Redis GEO",
      "summary": "Driver apps hold WebSockets to a location gateway which writes to Redis GEO sets sharded by city (GEOADD, 30 s TTL per driver). The matching service queries GEOSEARCH for nearby available drivers and assigns atomically with a Lua script that flips the driver from available to busy. Trips are stored in SQL; payments via a PSP.",
      "tradeoffs": [
        "Redis handles the write rate in memory",
        "Location loss on Redis failure is acceptable (next ping repairs it)",
        "City-level sharding keeps hot spots contained"
      ],
