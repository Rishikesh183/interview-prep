  "apis": [
    {
      "id": "a1",
      "ownerNodeId": "match",
      "method": "POST",
      "path": "/v1/rides",
      "request": "{ \"requestId\": \"r1\", \"pickup\": {\"lat\":12.97,\"lng\":77.59}, \"destination\": {\"lat\":13.0,\"lng\":77.6} }",
      "response": "202 { \"tripId\": \"t1\", \"status\": \"SEARCHING\" }",
      "statusCodes": "202, 409, 429",
      "auth": true,
      "idempotent": true,
      "note": "A geo candidate is not an assignment; conditionally claim before notifying the driver."
    },
    {
      "id": "a2",
      "ownerNodeId": "loc",
      "method": "WS",
      "path": "/v1/driver/location",
      "request": "{ \"driverId\": \"d1\", \"lat\": 12.97, \"lng\": 77.59, \"sequence\": 8, \"sentAt\": 1 }",
      "response": "{ \"type\": \"ack\", \"sequence\": 8 }; trip assignment events",
      "statusCodes": "101; unauthorized, stale_update",
      "auth": true,
      "idempotent": true,
      "note": "Kafka mode can use HTTP batch ingestion for the same message shape; ordering is per driver, not global."
    },
    {
      "id": "a3",
      "ownerNodeId": "trip",
      "method": "POST",
      "path": "/v1/trips/{id}/accept",
      "request": "{ \"offerId\": \"o1\", \"offerVersion\": 8, \"requestId\": \"r1\" }",
      "response": "200 { \"tripId\": \"t1\", \"status\": \"ASSIGNED\" }",
      "statusCodes": "200, 403, 409, 410",
      "auth": true,
      "idempotent": true,
      "note": "Accept only the current unexpired driver offer; reject stale versions and repeated claims from another driver."
    }
  ],
  "entities": [
    {
      "name": "Trip",
      "fields": "trip_id: string PK\nrider_id: string\ndriver_id: string?\nstatus: REQUESTED|ASSIGNED|ACTIVE|COMPLETED\nversion: int64",
      "storeNodeId": "db"
    },
    {
      "name": "DriverLocation",
      "fields": "driver_id: string member\ncity_or_cell: string\nlatitude: float64\nlongitude: float64\nupdated_at: timestamp\navailable: boolean",
      "storeNodeId": "geo"
    }
  ]
