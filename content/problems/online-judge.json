{
  "id": "online-judge",
  "number": 17,
  "title": "Online Judge (LeetCode)",
  "difficulty": "medium",
  "tags": ["sandboxing", "queues", "workers"],
  "prompt": "Design an online judge like LeetCode: users submit code for a problem, it runs against hidden test cases in a sandbox, and they see the verdict.",
  "functionalReqs": [
    "Submit code in several languages",
    "Run against hidden tests with time/memory limits",
    "Show verdict and runtime",
    "Contest mode with leaderboard"
  ],
  "nonFunctionalReqs": [
    "Untrusted code must never escape the sandbox",
    "Verdict within a few seconds normally",
    "Handle contest spikes (10× load)"
  ],
  "scale": {
    "dau": "~1M DAU",
    "qps": "~50 submissions/s normal, ~2K/s during contests",
    "storage": "Test data ~1 GB total; submissions ~5 KB each"
  },
  "outOfScope": ["Plagiarism detection", "Discussion forums"],
  "hints": [
    "Should the API server run user code?",
    "What happens to submissions during a 10× spike?",
    "How does the browser learn the verdict?"
  ],
  "keyComponents": [
    "api_gateway",
    "service",
    "message_queue",
    "worker",
    "object_storage",
    "sql_db",
    "websocket_server"
  ],
  "deepDives": [
    "Sandbox isolation (containers, gVisor, Firecracker)",
    "Queue-based autoscaling",
    "Result delivery (polling vs push)"
  ],
  "rubricFocus": ["Isolation", "Async execution", "Scaling under contest load"],
  "tests": [
    {
      "id": "async",
      "desc": "Submissions are queued for execution",
      "check": {
        "allOf": [
          {
            "edgeMatch": {
              "to": "queue",
              "mode": "async"
            }
          },
          {
            "pathExists": {
              "from": "queue",
              "to": "worker"
            }
          }
        ]
      }
    },
    {
      "id": "sandbox",
      "desc": "Code runs in an isolated sandbox",
      "check": {
        "mentions": "sandbox|container|isolat|gvisor|firecracker|seccomp|nsjail"
      }
    },
    {
      "id": "limits",
      "desc": "Time and memory limits are enforced",
      "check": {
        "mentions": "time limit|memory limit|timeout|cgroup|tle"
      }
    },
    {
      "id": "testdata",
      "desc": "Hidden test data is stored in object storage",
      "check": {
        "hasNode": "object_storage"
      }
    },
    {
      "id": "results",
      "desc": "Results are stored",
      "check": {
        "hasNode": "db"
      }
    },
    {
      "id": "submit-api",
      "desc": "A submit API exists",
      "check": {
        "apiMatch": {
          "method": "POST",
          "path~": "submi"
        }
      }
    },
    {
      "id": "verdict-delivery",
      "desc": "Clients get the verdict via polling or push",
      "check": {
        "anyOf": [
          {
            "apiMatch": {
              "method": "GET",
              "path~": "submi|result|status"
            }
          },
          {
            "hasNode": "websocket_server"
          }
        ]
      }
    },
    {
      "id": "autoscale",
      "desc": "Workers autoscale with queue depth",
      "check": {
        "mentions": "autoscal|queue depth|scale out"
      }
    }
  ],
  "references": [
    {
      "id": "queue-workers",
      "name": "Queue + sandboxed workers",
      "summary": "API stores the submission and enqueues it; judge workers pull jobs, run each test inside a Firecracker microVM / gVisor container with cgroup limits, and write the verdict. Clients poll GET /submissions/{id}. Workers autoscale on queue depth.",
      "tradeoffs": ["Spikes just lengthen the queue", "Polling is simple but chatty"],
      "graph": {
        "nodes": [
          {
            "id": "client",
            "type": "web_client",
            "position": {
              "x": 0,
              "y": 0
            },
            "data": {
              "label": "Browser",
              "config": {}
            }
          },
          {
            "id": "lb",
            "type": "load_balancer",
            "position": {
              "x": 260,
              "y": 0
            },
            "data": {
              "label": "LB",
              "config": {
                "layer": "L7",
                "algorithm": "round-robin",
                "healthChecks": true
              }
            }
          },
          {
            "id": "api",
            "type": "service",
            "position": {
              "x": 520,
              "y": 0
            },
            "data": {
              "label": "Submission API",
              "config": {
                "stateless": true,
                "instancesMin": 2,
                "instancesMax": 10,
                "autoscale": true,
                "language": ""
              }
            }
          },
          {
            "id": "db",
            "type": "sql_db",
            "position": {
              "x": 780,
              "y": 0
            },
            "data": {
              "label": "Submissions",
              "config": {
                "engine": "PostgreSQL",
                "replicas": 2,
                "readReplicas": false,
                "sharding": "none",
                "shardKey": ""
              }
            }
          },
          {
            "id": "q",
            "type": "message_queue",
            "position": {
              "x": 780,
              "y": 130
            },
            "data": {
              "label": "Judge queue",
              "config": {
                "engine": "SQS",
                "delivery": "at-least-once",
                "dlq": true,
                "fifo": false
              }
            }
          },
          {
            "id": "judge",
            "type": "worker",
            "position": {
              "x": 1040,
              "y": 0
            },
            "data": {
              "label": "Judge workers",
              "config": {
                "instances": 2,
                "concurrency": 4
              },
              "note": "Firecracker microVM sandbox per run; cgroup time limit + memory limit; autoscale on queue depth"
            }
          },
          {
            "id": "s3",
            "type": "object_storage",
            "position": {
              "x": 1300,
              "y": 0
            },
            "data": {
              "label": "Hidden test data",
              "config": {
                "engine": "S3",
                "lifecycle": ""
              }
            }
          }
        ],
        "edges": [
          {
            "id": "e1",
            "source": "client",
            "target": "lb",
            "sourceHandle": "r",
            "targetHandle": "l",
            "protocol": "HTTP",
            "mode": "sync"
          },
          {
            "id": "e2",
            "source": "lb",
            "target": "api",
            "sourceHandle": "r",
            "targetHandle": "l",
            "protocol": "HTTP",
            "mode": "sync"
          },
          {
            "id": "e3",
            "source": "api",
            "target": "db",
            "sourceHandle": "r",
            "targetHandle": "l",
            "protocol": "SQL",
            "mode": "sync",
            "op": "write"
          },
          {
            "id": "e4",
            "source": "api",
            "target": "q",
            "sourceHandle": "r",
            "targetHandle": "l",
            "protocol": "AMQP",
            "mode": "async"
          },
          {
            "id": "e5",
            "source": "q",
            "target": "judge",
            "sourceHandle": "r",
            "targetHandle": "l",
            "protocol": "AMQP",
            "mode": "async"
          },
          {
            "id": "e6",
            "source": "judge",
            "target": "s3",
            "sourceHandle": "r",
            "targetHandle": "l",
            "protocol": "HTTP",
            "mode": "sync",
            "op": "read"
          },
          {
            "id": "e7",
            "source": "judge",
            "target": "db",
            "sourceHandle": "r",
            "targetHandle": "l",
            "protocol": "SQL",
            "mode": "sync",
            "op": "write",
            "label": "verdict"
          }
        ]
      },
      "apis": [
        {
          "id": "a1",
          "ownerNodeId": "api",
          "method": "POST",
          "path": "/v1/submissions",
          "auth": true,
          "idempotent": true,
          "response": "{ submissionId }",
          "statusCodes": "202"
        },
        {
          "id": "a2",
          "ownerNodeId": "api",
          "method": "GET",
          "path": "/v1/submissions/{id}",
          "auth": true,
          "response": "{ status, verdict, runtimeMs }"
        }
      ],
      "entities": []
    },
    {
      "id": "serverless",
      "name": "Serverless execution",
      "summary": "Each submission triggers an isolated function per language runtime; results pushed via WebSocket.",
      "tradeoffs": [
        "No fleet to manage",
        "Cold starts and execution-time caps; weaker control over isolation"
      ]
    }
  ]
}
