            "data": {
              "label": "Metadata Service",
              "config": {
                "stateless": true,
                "instancesMin": 2,
                "instancesMax": 10,
                "autoscale": true,
                "language": ""
              },
              "note": "Returns presigned URLs for missing blocks; commit creates new version; conflicts → conflicted copy"
            }
          },
          {
            "id": "db",
            "type": "sql_db",
            "position": {
              "x": 780,
              "y": 0
            },
            "data": {
              "label": "Metadata DB",
              "config": {
                "engine": "PostgreSQL",
                "replicas": 3,
                "readReplicas": false,
                "sharding": "hash",
                "shardKey": "namespace_id"
              }
            }
          },
          {
            "id": "s3",
            "type": "object_storage",
            "position": {
              "x": 260,
              "y": 130
            },
            "data": {
              "label": "Block store",
              "config": {
                "engine": "S3",
                "lifecycle": ""
              },
              "note": "Content-addressed by hash (dedup)"
            }
          },
          {
            "id": "q",
            "type": "pub_sub",
            "position": {
              "x": 780,
              "y": 130
            },
            "data": {
              "label": "Change events",
              "config": {
                "engine": "Redis Pub/Sub",
                "fanOut": true
              },
              "note": "Fan-out: every notifier node gets each change"
            }
          },
          {
            "id": "notify",
            "type": "websocket_server",
            "position": {
              "x": 1040,
              "y": 0
            },
            "data": {
              "label": "Sync notifier",
              "config": {
                "instances": 10,
                "stickySessions": true,
                "connectionsPerNode": 50000
              }
            }
          },
          {
            "id": "cdn",
            "type": "cdn",
            "position": {
              "x": 260,
              "y": 260
            },
            "data": {
              "label": "CDN",
              "config": {
                "content": ["media"],
                "ttl": "1d"
              }
            }
          }
        ],
        "edges": [
          {
