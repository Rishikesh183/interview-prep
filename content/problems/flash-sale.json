{
  "id": "flash-sale",
  "number": 19,
  "title": "E-commerce Flash Sale",
  "difficulty": "medium",
  "tags": ["inventory-contention", "queue-buffering", "rate-limiting"],
  "prompt": "Design the backend for a flash sale: 10,000 units of a product go on sale at noon and millions of users try to buy at the same second.",
  "functionalReqs": [
    "Users attempt to buy during the sale window",
    "Exactly 10,000 units sold, never more",
    "Users learn quickly whether they got one",
    "Unpaid orders release stock after a timeout"
  ],
  "nonFunctionalReqs": [
    "Survive ~1M requests/s at the start",
    "No overselling",
    "Rest of the site stays up"
  ],
  "scale": {
    "qps": "~1M req/s peak for ~1 minute",
    "dau": "~5M participants"
  },
  "outOfScope": ["Recommendation", "Fraud ML models"],
  "hints": [
    "Most requests will fail. Reject them as early and cheaply as possible.",
    "Decrementing a DB row 1M times/s is a hot spot.",
    "Accept fast, process orders asynchronously."
  ],
  "keyComponents": ["cdn", "rate_limiter", "cache", "message_queue", "worker", "sql_db"],
  "deepDives": [
    "Atomic stock decrement in Redis",
    "Queue buffering of orders",
    "Static page + CDN for the sale page",
    "Payment timeout and stock release"
  ],
  "rubricFocus": ["Early rejection", "Atomic inventory", "Async order processing"],
  "tests": [
    {
      "id": "early-reject",
      "desc": "Excess traffic is rejected early (rate limit / gateway / waiting room)",
      "check": {
        "anyOf": [
          {
            "hasNode": "rate_limiter"
          },
          {
            "hasNode": "api_gateway"
          },
          {
            "mentions": "waiting room"
          }
        ]
      }
    },
    {
      "id": "static-cdn",
      "desc": "Sale page / static assets come from a CDN",
      "check": {
        "hasNode": "cdn"
      }
    },
    {
      "id": "atomic-stock",
      "desc": "Stock is decremented atomically in memory",
      "check": {
        "allOf": [
          {
            "hasNode": "cache"
          },
          {
            "mentions": "decr|atomic|lua|compare.?and"
          }
        ]
      }
    },
    {
      "id": "no-oversell",
      "desc": "Overselling is explicitly prevented",
      "check": {
        "mentions": "oversell|never more|stock.*(0|zero)|negative"
      }
    },
    {
      "id": "queue-buffer",
      "desc": "Orders are buffered through a queue",
      "check": {
        "allOf": [
          {
            "edgeMatch": {
              "to": "queue",
              "mode": "async"
            }
          },
          {
            "pathExists": {
              "from": "queue",
              "to": ["worker", "service"]
            }
          }
        ]
      }
    },
    {
      "id": "order-db",
      "desc": "Orders are persisted",
      "check": {
        "hasNode": "db"
      }
    },
    {
      "id": "release",
      "desc": "Unpaid orders release stock after a timeout",
      "check": {
        "mentions": "timeout|expir|release|ttl"
      }
    },
    {
      "id": "buy-api",
      "desc": "An idempotent buy API",
      "check": {
        "apiMatch": {
          "method": "POST",
          "idempotent": true
        }
      }
    }
  ],
  "references": [
    {
      "id": "redis-decr-queue",
      "name": "Redis DECR + order queue",
      "summary": "Sale page is static on the CDN. Gateway rate-limits per user. Buy requests DECR a Redis stock counter (Lua: only if > 0); winners get a token and an order message goes to a queue; workers create orders in SQL. Unpaid after 10 min → INCR stock back.",
      "tradeoffs": [
        "Handles huge QPS cheaply",
        "Redis is the source of truth during the sale; reconcile after"
      ],
      "graph": {
        "nodes": [
          {
            "id": "client",
            "type": "mobile_client",
            "position": {
              "x": 0,
              "y": 0
            },
            "data": {
              "label": "Shoppers",
              "config": {}
            }
          },
          {
            "id": "cdn",
