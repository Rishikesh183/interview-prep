{
  "id": "top-k-trending",
  "number": 28,
  "title": "Top-K Trending",
  "difficulty": "hard",
  "tags": ["heavy-hitters", "count-min-sketch", "streaming"],
  "prompt": "Design a service that shows the top 100 trending hashtags/videos over the last 1 hour, 1 day and 1 week, updated every minute, from a stream of billions of events/day.",
  "functionalReqs": [
    "Ingest view/mention events",
    "Return top-K for several time windows",
    "Results update about every minute"
  ],
  "nonFunctionalReqs": [
    "Approximate counts are OK for the 1-hour view",
    "Query latency < 50 ms",
    "Scales with event volume"
  ],
  "scale": {
    "qps": "~100K events/s",
    "storage": "~100M distinct items/day"
  },
  "outOfScope": ["Personalized trends", "Spam detection"],
  "hints": [
    "Exact counts for 100M items per minute is expensive. Can you approximate?",
    "How do you combine partial top-K lists from many workers?",
    "Should queries compute anything?"
  ],
  "keyComponents": ["event_stream", "stream_processor", "cache", "batch_processor", "service"],
  "deepDives": [
    "Count-min sketch + heap",
    "Sliding windows",
    "Merging partial top-K",
    "Lambda architecture for exact daily counts"
  ],
  "rubricFocus": [
    "Streaming aggregation",
    "Approximate algorithms",
    "Precomputed results for reads"
  ],
  "tests": [
    {
      "id": "stream",
      "desc": "Events flow through a stream",
      "check": {
        "hasNode": "event_stream"
      }
    },
    {
      "id": "processor",
      "desc": "A stream processor computes counts",
      "check": {
        "pathExists": {
          "from": "event_stream",
          "to": "stream_processor"
        }
      }
    },
    {
      "id": "approx",
      "desc": "Heavy-hitter / approximate counting is used",
      "check": {
        "mentions": "count.?min|sketch|heavy.?hitter|space.?saving|misra|heap"
      }
    },
    {
      "id": "windows",
      "desc": "Multiple time windows are maintained",
      "check": {
        "anyOf": [
          {
            "nodeConfig": {
              "type": "stream_processor",
              "config": {
                "windowing": ["tumbling", "sliding"]
              }
            }
          },
          {
            "mentions": "window"
          }
        ]
      }
    },
    {
      "id": "merge",
      "desc": "Partial results from partitions are merged",
      "check": {
        "mentions": "merge|combine|aggregat"
      }
    },
    {
      "id": "serving",
      "desc": "Precomputed top-K served from cache/store",
      "check": {
        "hasNode": ["cache", "nosql_kv", "sql_db"]
      }
    },
    {
      "id": "api",
      "desc": "A top-K query API",
      "check": {
        "apiMatch": {
          "method": "GET",
          "path~": "trend|top"
        }
      }
    }
  ],
  "references": [
    {
      "id": "cms-flink",
      "name": "Count-min sketch per window",
      "summary": "Kafka partitions events by item; Flink keeps a count-min sketch + min-heap per partition per 1-min bucket, emits partial top-K; an aggregator merges partials and writes top-100 per window to Redis.",
      "tradeoffs": ["Bounded memory", "Approximate; overcounts rare items slightly"],
      "graph": {
