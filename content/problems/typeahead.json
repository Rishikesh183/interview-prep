              "config": {
                "engine": "Kafka",
                "topic": "queries",
                "partitions": 12,
                "partitionKey": "",
                "retention": "7d"
              }
            }
          },
          {
            "id": "spark",
            "type": "batch_processor",
            "position": {
              "x": 1300,
              "y": 0
            },
            "data": {
              "label": "Top-K builder",
              "config": {
                "engine": "Spark",
                "schedule": "daily"
              },
              "note": "Aggregates counts, rebuilds the trie"
            }
          }
        ],
