{
  "id": "hotel-booking",
  "number": 16,
  "title": "Hotel Booking (Airbnb)",
  "difficulty": "medium",
  "tags": ["inventory", "reservations", "search"],
  "prompt": "Design a hotel/home reservation system like Airbnb or Booking.com: guests search listings by location and dates, see availability and price, and book.",
  "functionalReqs": [
    "Search listings by location, dates, guests",
    "View listing details and availability",
    "Reserve and pay",
    "Hosts manage listings and calendars"
  ],
  "nonFunctionalReqs": [
    "No overbooking",
    "Search < 500 ms",
    "Availability updates reflected within seconds"
  ],
  "scale": {
    "dau": "~20M DAU",
    "qps": "~20K searches/s peak, ~500 bookings/s peak",
    "storage": "~10M listings × 365 days inventory"
  },
  "outOfScope": ["Reviews", "Messaging between guest and host"],
  "hints": [
    "Model inventory per listing per night.",
    "Search needs geo + date filters; is SQL enough?",
    "Two guests book the last night at once."
  ],
  "keyComponents": [
    "service",
    "search_index",
    "sql_db",
    "cache",
    "external_service",
    "message_queue"
  ],
  "deepDives": [
    "Inventory model per date",
    "Search index sync (CDC)",
    "Reservation concurrency",
    "Payments and idempotency"
  ],
  "rubricFocus": ["Inventory modelling", "Overbooking prevention", "Search architecture"],
  "tests": [
    {
      "id": "search-index",
      "desc": "A search index serves listing search",
      "check": {
        "hasNode": "search_index"
      }
    },
    {
      "id": "inventory-db",
      "desc": "Inventory and reservations live in a transactional DB",
      "check": {
        "hasNode": "sql_db"
      }
    },
    {
      "id": "inventory-model",
      "desc": "Inventory is modelled per date/night",
      "check": {
        "anyOf": [
          {
            "entityMatch": {
              "fields~": "date|night"
            }
          },
          {
            "mentions": "per.?(date|night)|calendar"
          }
        ]
      }
    },
    {
      "id": "overbooking",
      "desc": "Overbooking is prevented",
      "check": {
        "mentions": "overbook|optimistic|for update|unique|version|lock"
      }
    },
    {
      "id": "index-sync",
      "desc": "Search index is kept in sync with the DB",
      "check": {
        "anyOf": [
          {
            "edgeMatch": {
              "to": "search_index"
            }
          },
          {
            "mentions": "cdc|change data|sync"
          }
        ]
      }
    },
    {
      "id": "payments",
      "desc": "Payments go through a provider",
      "check": {
        "hasNode": "external_service"
      }
    },
    {
      "id": "reserve-api",
      "desc": "An idempotent reservation API",
      "check": {
        "apiMatch": {
          "method": "POST",
          "idempotent": true,
          "path~": "reserv|book"
        }
      }
    },
    {
      "id": "scale-out",
      "desc": "Every service sits behind a load balancer or API gateway",
      "check": {
        "upstreamOf": "service",
        "anyType": "entry"
      },
      "hint": "Put a load balancer or API gateway in front of your services so they can scale horizontally."
    }
  ],
  "references": [
    {
      "id": "inventory-table",
      "name": "Room-night inventory table",
      "summary": "room_inventory(listing_id, date, total, reserved) with a version column; booking increments reserved with a conditional update. Search via Elasticsearch fed by CDC from the DB.",
      "tradeoffs": ["Clear, auditable", "Many rows per listing; partition by listing_id"],
      "graph": {
        "nodes": [
          {
            "id": "client",
            "type": "web_client",
            "position": {
              "x": 0,
              "y": 0
            },
            "data": {
              "label": "Guests",
              "config": {}
            }
          },
          {
            "id": "lb",
            "type": "load_balancer",
            "position": {
              "x": 260,
              "y": 0
            },
            "data": {
              "label": "LB",
              "config": {
                "layer": "L7",
                "algorithm": "round-robin",
                "healthChecks": true
              }
            }
          },
          {
            "id": "search",
            "type": "service",
            "position": {
              "x": 520,
              "y": 0
            },
            "data": {
              "label": "Search Service",
              "config": {
                "stateless": true,
                "instancesMin": 2,
                "instancesMax": 10,
                "autoscale": true,
                "language": ""
              }
            }
          },
          {
            "id": "book",
            "type": "service",
            "position": {
              "x": 520,
              "y": 130
            },
            "data": {
              "label": "Reservation Service",
              "config": {
                "stateless": true,
                "instancesMin": 2,
                "instancesMax": 10,
                "autoscale": true,
                "language": ""
              },
              "note": "Conditional UPDATE ... SET reserved = reserved + 1 WHERE reserved < total AND version = ? (no overbooking)"
            }
          },
          {
            "id": "es",
            "type": "search_index",
            "position": {
              "x": 780,
              "y": 0
            },
            "data": {
              "label": "Listings index",
              "config": {
                "engine": "Elasticsearch",
                "indexedFields": ""
              }
            }
          },
          {
            "id": "db",
            "type": "sql_db",
            "position": {
              "x": 780,
              "y": 130
            },
            "data": {
              "label": "Inventory DB",
              "config": {
                "engine": "PostgreSQL",
                "replicas": 3,
                "readReplicas": false,
                "sharding": "none",
                "shardKey": "",
                "isolation": "repeatable-read"
              }
            }
          },
          {
            "id": "cdc",
            "type": "event_stream",
            "position": {
              "x": 1040,
              "y": 0
            },
            "data": {
              "label": "CDC stream",
              "config": {
                "engine": "Kafka",
                "topic": "inventory-changes",
                "partitions": 12,
                "partitionKey": "",
                "retention": "7d"
              },
              "note": "Change data capture (Debezium)"
            }
          },
          {
            "id": "indexer",
            "type": "worker",
            "position": {
              "x": 1300,
              "y": 0
            },
            "data": {
              "label": "Index updater",
              "config": {
                "instances": 2,
                "concurrency": 10
              }
            }
          },
          {
            "id": "psp",
            "type": "external_service",
            "position": {
              "x": 780,
              "y": 260
            },
            "data": {
              "label": "Payments",
              "config": {
                "provider": "Stripe"
              }
            }
          }
        ],
        "edges": [
          {
            "id": "e1",
            "source": "client",
            "target": "lb",
            "sourceHandle": "r",
            "targetHandle": "l",
            "protocol": "HTTP",
            "mode": "sync"
          },
          {
            "id": "e2",
            "source": "lb",
            "target": "search",
            "sourceHandle": "r",
            "targetHandle": "l",
            "protocol": "HTTP",
            "mode": "sync"
          },
          {
            "id": "e3",
            "source": "lb",
            "target": "book",
            "sourceHandle": "r",
            "targetHandle": "l",
            "protocol": "HTTP",
            "mode": "sync"
          },
          {
            "id": "e4",
            "source": "search",
            "target": "es",
            "sourceHandle": "r",
            "targetHandle": "l",
            "protocol": "TCP",
            "mode": "sync",
            "op": "read"
          },
          {
            "id": "e5",
            "source": "book",
            "target": "db",
            "sourceHandle": "r",
            "targetHandle": "l",
            "protocol": "SQL",
            "mode": "sync",
            "op": "read_write"
          },
          {
            "id": "e6",
            "source": "book",
            "target": "psp",
            "sourceHandle": "r",
            "targetHandle": "l",
            "protocol": "HTTP",
            "mode": "sync"
          },
          {
            "id": "e7",
            "source": "db",
            "target": "cdc",
            "sourceHandle": "r",
            "targetHandle": "l",
            "protocol": "Kafka",
            "mode": "async"
          },
          {
            "id": "e8",
            "source": "cdc",
            "target": "indexer",
            "sourceHandle": "r",
            "targetHandle": "l",
            "protocol": "Kafka",
            "mode": "async"
          },
          {
            "id": "e9",
            "source": "indexer",
            "target": "es",
            "sourceHandle": "r",
            "targetHandle": "l",
            "protocol": "TCP",
            "mode": "sync",
            "op": "write"
          }
        ]
      },
      "apis": [
        {
          "id": "a1",
          "ownerNodeId": "search",
          "method": "GET",
          "path": "/v1/search",
          "auth": false,
          "pagination": "cursor"
        },
        {
          "id": "a2",
          "ownerNodeId": "book",
          "method": "POST",
          "path": "/v1/reservations",
          "auth": true,
          "idempotent": true,
          "statusCodes": "201, 409"
        }
      ],
      "entities": [
        {
          "name": "RoomInventory",
          "fields": "listing_id, date, total, reserved, version"
        }
      ]
    },
    {
      "id": "calendar-blocks",
      "name": "Calendar blocks per listing",
      "summary": "Store booked date ranges per listing; reserve with an exclusion constraint on overlapping ranges (Postgres) inside a transaction.",
      "tradeoffs": ["Compact for single-unit homes", "Harder for hotels with many identical rooms"]
    }
  ]
}
