  "apis": [
    {
      "id": "a1",
      "ownerNodeId": "collab",
      "method": "WS",
      "path": "/v1/documents/{id}/session",
      "request": "{ \"type\": \"edit\", \"operationId\": \"op1\", \"baseRevision\": 42, \"update\": \"encoded-op\" }",
      "response": "{ \"type\": \"ack\", \"operationId\": \"op1\", \"revisionOrClock\": \"43\" }; broadcast update",
      "statusCodes": "101; forbidden, stale_revision, unavailable",
      "auth": true,
      "note": "Persist edits before ack. OT transforms against the server revision; CRDT exchanges state vectors and missing updates."
    },
    {
      "id": "a2",
      "ownerNodeId": "docs",
      "method": "GET",
      "path": "/v1/documents/{id}",
      "request": "No request body.",
      "response": "200 { \"snapshotUrl\": \"signed-url\", \"checkpoint\": \"42\", \"operations\": [] }",
      "statusCodes": "200, 403, 404",
      "auth": true,
      "idempotent": true,
      "note": "Authorize both snapshot access and log replay; a snapshot reduces startup replay work."
    }
  ],
  "entities": [
    {
      "name": "Operation",
