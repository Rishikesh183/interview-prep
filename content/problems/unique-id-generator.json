{
  "id": "unique-id-generator",
  "number": 4,
  "title": "Unique ID Generator",
  "difficulty": "easy",
  "tags": ["snowflake", "clock-skew", "distributed"],
  "prompt": "Design a service that generates unique 64-bit IDs for a distributed system at very high throughput. IDs should be roughly sortable by time.",
  "functionalReqs": [
    "Generate globally unique 64-bit numeric IDs",
    "IDs are roughly ordered by creation time",
    "Batch generation"
  ],
  "nonFunctionalReqs": [
    "> 100K IDs/s per node",
    "No single point of failure",
    "Low latency (< 1 ms)"
  ],
  "scale": {
    "qps": "~1M IDs/s across all callers",
    "notes": "Hundreds of calling services across 3 regions"
  },
  "outOfScope": ["Human-readable IDs"],
  "hints": [
    "Twitter Snowflake packs timestamp + machine ID + sequence into 64 bits.",
    "What happens if a machine's clock jumps backwards?",
    "How does each generator get a unique machine ID?"
  ],
  "keyComponents": ["id_generator", "coordination", "service"],
  "deepDives": [
    "Bit layout (timestamp / datacenter / worker / sequence)",
    "Clock skew and NTP",
    "Worker ID assignment"
  ],
  "rubricFocus": ["Correct bit allocation", "Clock-skew handling", "No central bottleneck"],
  "tests": [
    {
      "id": "generator",
      "desc": "An ID generator component exists",
      "check": {
        "anyOf": [
          {
            "hasNode": "id_generator"
          },
          {
            "hasNode": "service"
          }
        ]
      }
    },
    {
      "id": "time-ordered",
      "desc": "IDs embed a timestamp for rough ordering",
      "check": {
        "mentions": "snowflake|timestamp|epoch|time.?based|ulid"
      }
    },
    {
      "id": "worker-ids",
      "desc": "Each generator gets a unique worker/machine ID",
      "check": {
        "anyOf": [
          {
            "hasNode": "coordination"
          },
          {
            "mentions": "worker.?id|machine.?id|node.?id|datacenter"
          }
        ]
      }
    },
    {
      "id": "sequence",
      "desc": "A per-millisecond sequence handles bursts",
      "check": {
        "mentions": "sequence|counter"
      }
    },
    {
      "id": "clock-skew",
      "desc": "Clock going backwards is handled",
      "check": {
        "mentions": "clock|ntp|skew|backward"
      },
      "hint": "Refuse to generate (or wait) when the clock moves backwards."
    },
    {
      "id": "no-spof",
      "desc": "Multiple generator instances run independently",
      "check": {
        "anyOf": [
          {
            "hasNode": "id_generator",
            "min": 2
          },
          {
            "nodeConfig": {
              "type": ["service", "id_generator"],
              "text~": "instances|replica|independent|each node"
            }
          },
          {
            "hasNode": "load_balancer"
          }
        ]
      }
    },
    {
      "id": "api",
      "desc": "An API returns new IDs",
      "check": {
        "apiMatch": {
          "method": ["GET", "POST", "RPC"],
          "path~": "id"
        }
      }
    }
  ],
  "references": [
    {
      "id": "snowflake",
      "name": "Snowflake",
      "summary": "41-bit ms timestamp, 5-bit datacenter, 5-bit worker, 12-bit sequence. Worker IDs leased from ZooKeeper at startup. Generators are stateless otherwise and run in every region.",
      "tradeoffs": [
        "4096 IDs/ms per worker",
        "Depends on reasonably synced clocks",
        "~69 years of timestamps"
      ],
      "graph": {
        "nodes": [
          {
            "id": "client",
            "type": "web_client",
            "position": {
              "x": 0,
              "y": 0
            },
            "data": {
              "label": "Callers",
              "config": {}
            }
          },
          {
            "id": "lb",
            "type": "load_balancer",
            "position": {
              "x": 260,
              "y": 0
            },
            "data": {
              "label": "LB",
              "config": {
                "layer": "L7",
                "algorithm": "round-robin",
                "healthChecks": true
              }
            }
          },
          {
            "id": "svc",
            "type": "service",
            "position": {
              "x": 520,
              "y": 0
            },
            "data": {
              "label": "Order Service",
              "config": {
                "stateless": true,
                "instancesMin": 2,
                "instancesMax": 10,
                "autoscale": true,
                "language": ""
              },
              "note": "Asks for IDs in batches"
            }
          },
          {
            "id": "idgen",
            "type": "id_generator",
            "position": {
              "x": 780,
              "y": 0
            },
            "data": {
              "label": "Snowflake generators",
              "config": {
                "strategy": "snowflake"
              },
              "note": "41-bit timestamp + 5-bit datacenter + 5-bit worker id + 12-bit sequence; refuses to issue IDs if the clock moves backwards (NTP skew)"
            }
          },
          {
            "id": "zk",
            "type": "coordination",
            "position": {
              "x": 1040,
              "y": 0
            },
            "data": {
              "label": "ZooKeeper",
              "config": {
                "engine": "ZooKeeper",
                "purpose": "config"
              },
              "note": "Leases a unique worker id to each generator at startup"
            }
          }
        ],
        "edges": [
          {
            "id": "e1",
            "source": "client",
            "target": "lb",
            "sourceHandle": "r",
            "targetHandle": "l",
            "protocol": "HTTP",
            "mode": "sync"
          },
          {
            "id": "e2",
            "source": "lb",
            "target": "svc",
            "sourceHandle": "r",
            "targetHandle": "l",
            "protocol": "HTTP",
            "mode": "sync"
          },
          {
            "id": "e3",
            "source": "svc",
            "target": "idgen",
            "sourceHandle": "r",
            "targetHandle": "l",
            "protocol": "gRPC",
            "mode": "sync"
          },
          {
            "id": "e4",
            "source": "idgen",
            "target": "zk",
            "sourceHandle": "r",
            "targetHandle": "l",
            "protocol": "TCP",
            "mode": "sync",
            "op": "read_write"
          }
        ]
      },
      "apis": [
        {
          "id": "a1",
          "ownerNodeId": "idgen",
          "method": "RPC",
          "path": "/ids.Next",
          "auth": true,
          "request": "{ count }",
          "response": "{ ids[] }"
        }
      ],
      "entities": []
    },
    {
      "id": "ticket-server",
      "name": "Ticket servers with ranges",
      "summary": "Two DB-backed ticket servers hand out ranges (odd/even) of 10K IDs; app servers allocate locally from their range.",
      "tradeoffs": [
        "Simple and strictly unique",
        "Not time-ordered across servers",
        "Ranges are lost on crash (gaps)"
      ]
    },
    {
      "id": "uuid",
      "name": "UUID v7 in-process",
      "summary": "Each service generates 128-bit UUIDv7 locally (timestamp + randomness). No coordination at all.",
      "tradeoffs": [
        "Zero infrastructure",
        "128-bit, not 64",
        "Index locality is fine because v7 is time-ordered"
      ]
    }
  ]
}
