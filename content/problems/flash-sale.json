            "position": {
              "x": 260,
              "y": 0
            },
            "data": {
              "label": "CDN",
              "config": {
                "content": ["static"],
                "ttl": "1d"
              },
              "note": "Sale page is static"
            }
          },
          {
            "id": "gw",
            "type": "api_gateway",
            "position": {
              "x": 260,
              "y": 130
            },
            "data": {
              "label": "Gateway",
              "config": {
                "auth": true,
                "rateLimiting": true,
                "routing": true
              },
              "note": "Per-user rate limit rejects excess early"
            }
          },
          {
            "id": "sale",
            "type": "service",
            "position": {
              "x": 520,
              "y": 0
            },
            "data": {
              "label": "Sale Service",
              "config": {
                "stateless": true,
                "instancesMin": 2,
                "instancesMax": 10,
                "autoscale": true,
                "language": ""
              },
              "note": "Lua: DECR stock only if > 0, so we never oversell"
            }
          },
          {
            "id": "redis",
            "type": "cache",
            "position": {
              "x": 780,
              "y": 0
            },
            "data": {
              "label": "Stock counter",
              "config": {
                "engine": "Redis",
                "strategy": "write-through",
                "eviction": "TTL",
                "ttl": "2h",
                "cluster": false
