{
  "id": "url-shortener",
  "number": 1,
  "title": "URL Shortener",
  "difficulty": "easy",
  "priority": true,
  "tags": ["hashing", "id-generation", "caching", "read-heavy"],
  "prompt": "Design a URL shortening service like bit.ly. Users submit a long URL and get back a short link (e.g. sho.rt/aZ3kQ9). Visiting the short link redirects to the original URL. Optionally users can pick a custom alias and set an expiry.",
  "functionalReqs": [
    "Create a short URL from a long URL",
    "Redirect a short URL to the original long URL",
    "Optional custom alias",
    "Optional expiry time per link"
  ],
  "nonFunctionalReqs": [
    "Highly available: redirects must keep working",
    "Low latency redirects (p99 < 50 ms)",
    "Short codes must be unique and not easily guessable",
    "Read-heavy: ~100:1 reads to writes"
  ],
  "scale": {
    "dau": "~100M new URLs/month (~40 writes/s avg)",
    "qps": "~4K redirects/s avg, ~12K/s peak",
    "storage": "~500 B per mapping, 5-year retention → ~3 TB",
    "notes": "100:1 read:write"
  },
  "outOfScope": ["Analytics dashboards", "User accounts and link management UI"],
  "hints": [
    "7 base62 characters give 62^7 ≈ 3.5 trillion codes. How do you generate them without collisions?",
    "Redirects vastly outnumber writes. Which component keeps the hot mappings close?",
    "301 is cached by browsers; 302 hits your servers every time. Which one fits if you want analytics later?"
  ],
  "keyComponents": ["load_balancer", "service", "cache", "nosql_kv", "id_generator"],
  "deepDives": [
    "ID generation: counter + base62 vs hashing vs pre-generated key service",
    "Cache-aside on the redirect path and cache sizing (80/20)",
    "301 vs 302 redirects",
    "Handling expiry and custom alias collisions"
  ],
  "rubricFocus": [
    "Collision-free code generation with a clear strategy",
    "Read path optimized with caching",
    "Choice of datastore justified by access pattern (key lookups)"
  ],
  "tests": [
    {
      "id": "unique-ids",
      "desc": "Short codes are generated without collisions",
      "check": {
        "anyOf": [
          {
            "hasNode": "id_generator"
          },
          {
            "nodeConfig": {
              "type": "*",
              "text~": "base62|counter|snowflake|hash|key.?gen"
            }
          }
        ]
      },
      "hint": "Add an ID generator, or note how a service produces unique codes (counter + base62, hash + collision check...)."
    },
    {
      "id": "fast-redirect",
      "desc": "The redirect path can hit a cache before the database",
      "check": {
        "pathExists": {
          "from": "client",
          "via": ["cache"],
          "to": "db"
        }
      },
      "hint": "Put a cache on the read path (cache-aside from the service is fine)."
    },
    {
      "id": "durable-store",
      "desc": "Mappings are stored durably",
      "check": {
        "pathExists": {
          "from": "client",
          "to": "db"
        }
      },
      "hint": "Clients should reach a database through your services."
    },
    {
      "id": "scale-out",
      "desc": "Every service sits behind a load balancer or API gateway",
      "check": {
        "upstreamOf": "service",
        "anyType": "entry"
      },
      "hint": "Put a load balancer or API gateway in front of your services so they can scale horizontally."
    },
    {
      "id": "create-api",
      "desc": "An API creates short URLs",
      "check": {
        "apiMatch": {
          "method": "POST",
          "path~": "url|link|shorten"
        }
      },
      "hint": "Define something like POST /v1/urls on your service."
    },
    {
      "id": "redirect-api",
      "desc": "A GET endpoint takes the short code as a path parameter",
      "check": {
        "apiMatch": {
          "method": "GET",
          "path~": "\\{[^}]+\\}|/:\\w+"
        }
      },
      "hint": "Define GET /{code} that returns a redirect."
    },
    {
      "id": "mapping-entity",
      "desc": "The data model stores the long URL against the code",
      "check": {
        "entityMatch": {
          "fields~": "long|original|target|url"
        }
      },
      "hint": "Add an entity like UrlMapping(code, long_url, created_at, expires_at)."
    },
    {
      "id": "redirect-status",
      "desc": "Chooses between 301 and 302 redirects",
      "check": {
        "mentions": "30[127]"
      },
      "hint": "Write down whether redirects are 301 (permanent) or 302 (temporary) and why."
    }
  ],
  "references": [
    {
      "id": "counter-base62",
      "name": "Counter + base62 with cache-aside",
      "summary": "An ID generator hands out unique 64-bit numbers which the service base62-encodes into 7-char codes. Mappings live in a key-value store keyed by code. Redirects check Redis first (cache-aside) and fall back to the KV store.",
      "tradeoffs": [
        "No collisions and no retries, but sequential codes are guessable unless the counter is shuffled",
        "The ID generator must be highly available (use ranges per server to avoid a hot path)",
        "KV store scales linearly for point lookups; no joins needed"
      ],
      "graph": {
        "nodes": [
          {
            "id": "client",
            "type": "web_client",
            "position": {
              "x": 0,
              "y": 0
            },
            "data": {
              "label": "Browser",
              "config": {}
            }
          },
          {
