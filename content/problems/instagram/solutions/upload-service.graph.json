  "apis": [
    {
      "id": "a1",
      "ownerNodeId": "up",
      "method": "POST",
      "path": "/v1/uploads",
      "request": "{ \"contentType\": \"image/jpeg\", \"sizeBytes\": 1048576, \"caption\": \"hello\" }",
      "response": "201 { \"postId\": \"p1\", \"uploadUrl\": \"signed-or-service-url\" }",
      "statusCodes": "201, 400, 413",
      "auth": true,
      "note": "Presigned mode transfers bytes to object storage; upload-service mode streams them through the upload fleet."
    },
    {
      "id": "a2",
      "ownerNodeId": "api",
      "method": "POST",
      "path": "/v1/posts/{id}/complete",
      "request": "{ \"uploadId\": \"u1\", \"checksum\": \"sha256...\" }",
      "response": "202 { \"postId\": \"p1\", \"status\": \"PROCESSING\" }",
      "statusCodes": "202, 409",
      "auth": true,
      "idempotent": true,
      "note": "A retry must not enqueue unbounded duplicate processing; confirm the referenced object belongs to the user."
    },
    {
      "id": "a3",
      "ownerNodeId": "api",
      "method": "GET",
      "path": "/v1/feed",
      "request": "No request body; ?cursor=42&limit=20",
      "response": "200 { \"posts\": [], \"nextCursor\": \"43\" }",
      "statusCodes": "200, 401",
      "auth": true,
      "idempotent": true,
      "pagination": "cursor",
      "note": "Return CDN URLs for READY variants, not original photo bytes through the API."
    }
  ],
  "entities": [
    {
      "name": "Post",
      "fields": "post_id: string PK\nauthor_id: string\ncaption: string\nmedia_keys: string[]\nstatus: UPLOADING|PROCESSING|READY\ncreated_at: timestamp",
      "storeNodeId": "meta"
    },
    {
      "name": "PhotoObject",
      "fields": "object_key: string PK\npost_id: string\nvariant: original|thumbnail\nchecksum: string",
      "storeNodeId": "s3"
    }
  ]
