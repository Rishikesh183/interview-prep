          "method": "GET",
          "path": "/v1/suggest",
          "auth": false,
          "request": "?q=prefix&locale=en"
        }
      ],
      "entities": []
    },
    {
      "id": "redis-zsets",
      "name": "Prefix → sorted set in Redis",
      "summary": "For each prefix up to 10 chars keep a Redis sorted set of top queries; a streaming job increments scores.",
      "tradeoffs": ["Fresh within minutes", "Huge key count; prune long-tail prefixes"]
    }
  ]
}
