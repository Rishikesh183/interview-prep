{
  "id": "distributed-cache",
  "number": 5,
  "title": "Distributed Cache",
  "difficulty": "easy",
  "tags": ["consistent-hashing", "eviction", "replication"],
  "prompt": "Design a distributed in-memory cache like Memcached/Redis Cluster that application servers use for get/set with TTL. It should scale horizontally to hundreds of nodes.",
  "functionalReqs": [
    "get(key), set(key, value, ttl), delete(key)",
    "Automatic eviction when memory is full",
    "Add/remove nodes without downtime"
  ],
  "nonFunctionalReqs": [
    "Sub-millisecond reads",
    "Survives node failures with minimal misses",
    "Even key distribution"
  ],
  "scale": {
    "qps": "~5M ops/s",
    "storage": "~10 TB total memory",
    "notes": "Values avg 1 KB, hot keys exist"
  },
  "outOfScope": ["Persistence to disk", "Transactions"],
  "hints": [
    "hash(key) % N reshuffles almost everything when N changes.",
    "One celebrity key can overload a single node. Options?",
    "Who knows which nodes are alive?"
  ],
  "keyComponents": ["cache", "coordination", "service_discovery"],
  "deepDives": [
    "Consistent hashing with virtual nodes",
    "Replication and failover",
    "Hot keys",
    "Eviction policies"
  ],
  "rubricFocus": ["Partitioning scheme", "Membership & failure detection", "Eviction policy"],
  "tests": [
    {
      "id": "partitioning",
      "desc": "Keys are partitioned with consistent hashing",
      "check": {
        "mentions": "consistent.?hash|hash.?ring|virtual.?node|hash.?slot"
      }
    },
    {
      "id": "cluster",
      "desc": "The cache runs as a multi-node cluster",
      "check": {
        "anyOf": [
          {
            "nodeConfig": {
              "type": "cache",
              "config": {
                "cluster": true
              }
            }
          },
          {
            "hasNode": "cache",
            "min": 2
          }
        ]
      }
    },
    {
      "id": "eviction",
      "desc": "An eviction policy is defined",
      "check": {
        "mentions": "lru|lfu|evict"
      }
    },
    {
      "id": "replication",
      "desc": "Data is replicated for failover",
      "check": {
        "mentions": "replica|replicat|failover"
      }
    },
    {
      "id": "membership",
      "desc": "Cluster membership / failure detection exists",
      "check": {
        "anyOf": [
          {
            "hasNode": "coordination"
          },
          {
            "hasNode": "service_discovery"
          },
          {
            "mentions": "gossip|heartbeat|membership"
          }
        ]
      }
    },
    {
      "id": "hot-keys",
      "desc": "Hot keys are addressed",
      "check": {
        "mentions": "hot.?key|local cache|near cache|replicate hot"
      }
    },
    {
      "id": "client-routing",
      "desc": "Clients route requests to the right node",
      "check": {
        "mentions": "client.?(library|side)|smart client|proxy|router|twemproxy"
      }
    }
  ],
  "references": [
    {
      "id": "client-side-ring",
      "name": "Smart clients + consistent hashing",
      "summary": "Client library holds the hash ring (150 virtual nodes per server) from service discovery and talks to nodes directly. Each key is replicated to the next node on the ring.",
      "tradeoffs": ["No proxy hop", "Clients must update rings consistently"],
      "graph": {
        "nodes": [
          {
            "id": "client",
            "type": "web_client",
            "position": {
              "x": 0,
              "y": 0
            },
            "data": {
              "label": "Users",
              "config": {}
            }
          },
          {
