  "apis": [
    {
      "id": "a1",
      "ownerNodeId": "meta",
      "method": "POST",
      "path": "/v1/files/{path}/upload-session",
      "request": "{ \"blocks\": [{ \"hash\": \"sha256...\", \"size\": 4194304 }] }",
      "response": "201 { \"uploadId\": \"u1\", \"missingBlocks\": [], \"uploadUrls\": [] }",
      "statusCodes": "201, 400, 403",
      "auth": true,
      "note": "Presigned mode returns signed object-store URLs; upload-service mode returns service chunk URLs."
    },
    {
      "id": "a2",
      "ownerNodeId": "meta",
      "method": "POST",
      "path": "/v1/files/{path}/commit",
      "request": "{ \"uploadId\": \"u1\", \"expectedVersion\": 2, \"blockHashes\": [\"sha256...\"] }",
      "response": "201 { \"fileId\": \"f1\", \"version\": 3 }",
      "statusCodes": "201, 409",
      "auth": true,
      "note": "Commit the version and change cursor atomically; incomplete blocks must not become a visible file."
    },
    {
      "id": "a3",
      "ownerNodeId": "meta",
      "method": "GET",
      "path": "/v1/changes",
      "request": "No request body; ?cursor=42&limit=100",
      "response": "200 { \"changes\": [], \"nextCursor\": \"43\" }",
      "statusCodes": "200, 403",
      "auth": true,
      "idempotent": true,
      "pagination": "cursor",
      "note": "A durable cursor recovers missed WebSocket hints or long-poll responses."
    }
  ],
  "entities": [
    {
      "name": "FileVersion",
      "fields": "file_id: string\nversion: int64\nowner_id: string\npath: string\nblock_hashes: string[]\nupdated_at: timestamp",
      "storeNodeId": "db"
    },
    {
      "name": "Block",
      "fields": "block_hash: string PK\nobject_key: string\nsize_bytes: int64\nchecksum: string",
      "storeNodeId": "s3"
    }
  ]
}
