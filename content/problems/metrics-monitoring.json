{
  "id": "metrics-monitoring",
  "number": 20,
  "title": "Metrics & Monitoring",
  "difficulty": "medium",
  "tags": ["time-series", "aggregation", "alerting"],
  "prompt": "Design a metrics monitoring and alerting system like Datadog/Prometheus for a company running 100K servers.",
  "functionalReqs": [
    "Collect metrics (CPU, latency, custom counters) from hosts and services",
    "Query and graph metrics over time",
    "Alert rules that notify on-call via email/SMS/pager",
    "Downsample old data"
  ],
  "nonFunctionalReqs": [
    "Ingest millions of points/s",
    "Dashboards query in < 1 s",
    "Alerts fire within a minute",
    "Retention: 1 year (downsampled)"
  ],
  "scale": {
    "qps": "~100K hosts × 100 metrics every 10 s → ~1M points/s",
    "storage": "~16 B/point compressed → ~1.4 TB/day raw"
  },
  "outOfScope": ["Log search", "Distributed tracing"],
  "hints": [
    "Push or pull collection?",
    "Raw 10 s data for a year is a lot. What do you keep?",
    "Alert evaluation shouldn't hit the same store dashboards hammer."
  ],
  "keyComponents": [
    "event_stream",
    "stream_processor",
    "time_series_db",
    "service",
    "notification_service"
  ],
  "deepDives": [
    "Push vs pull",
    "Time-series storage and compression",
    "Downsampling/rollups",
    "Alert evaluation"
  ],
  "rubricFocus": ["Ingestion pipeline", "Storage choice", "Alerting path"],
  "tests": [
    {
      "id": "tsdb",
      "desc": "Metrics are stored in a time-series DB",
      "check": {
        "hasNode": "time_series_db"
      }
    },
    {
      "id": "ingest-buffer",
      "desc": "Ingestion is buffered through a stream/queue",
      "check": {
        "pathExists": {
          "from": "queue",
          "to": ["time_series_db", "stream_processor", "worker"]
        }
      }
    },
    {
      "id": "aggregation",
      "desc": "Metrics are aggregated / rolled up",
      "check": {
        "anyOf": [
          {
            "hasNode": "stream_processor"
          },
          {
            "hasNode": "batch_processor"
          },
          {
            "mentions": "rollup|downsampl|aggregat"
          }
        ]
      }
    },
    {
      "id": "retention",
      "desc": "Retention / downsampling policy is defined",
      "check": {
        "mentions": "retention|downsampl|rollup|ttl"
      }
    },
    {
      "id": "alerting",
      "desc": "Alerts notify on-call",
      "check": {
        "anyOf": [
          {
            "hasNode": "notification_service"
          },
          {
            "pathExists": {
              "from": "*",
              "to": "external_service"
            }
          }
        ]
      }
    },
    {
      "id": "collection",
      "desc": "Collection model (push agents or pull scraping) is chosen",
      "check": {
        "mentions": "push|pull|scrap|agent"
      }
    },
    {
      "id": "query-api",
      "desc": "A query API returns series for a time range",
      "check": {
        "apiMatch": {
          "method": ["GET", "POST"],
          "path~": "query|metric|series"
        }
      }
    }
  ],
  "references": [
    {
      "id": "push-kafka",
      "name": "Push agents → Kafka → TSDB",
      "summary": "Agents push batches to collectors which write to Kafka; consumers write to a sharded TSDB; a Flink job computes 1-min/1-h rollups; alert evaluator reads recent data from Kafka/stream and notifies via PagerDuty.",
      "tradeoffs": ["Buffering absorbs spikes", "More moving parts"],
      "graph": {
        "nodes": [
          {
            "id": "agents",
            "type": "external_service",
            "position": {
              "x": 0,
              "y": 0
            },
            "data": {
