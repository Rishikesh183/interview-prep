{
  "id": "payment-system",
  "number": 23,
  "title": "Payment System / Wallet",
  "difficulty": "hard",
  "priority": true,
  "tags": ["idempotency", "ledger", "reconciliation", "consistency"],
  "prompt": "Design the payment backend for an e-commerce company: it charges customers through external payment service providers (PSPs), keeps an internal wallet/ledger, pays out to sellers, and reconciles with the PSPs daily.",
  "functionalReqs": [
    "Charge a customer for an order via a PSP",
    "Maintain wallet balances via a ledger",
    "Pay out sellers",
    "Handle PSP webhooks (success/failure/refund)",
    "Daily reconciliation with PSP reports"
  ],
  "nonFunctionalReqs": [
    "Never double-charge or lose money",
    "Every balance change is auditable",
    "Strong consistency for balances",
    "Tolerate PSP timeouts and retries"
  ],
  "scale": {
    "qps": "~1K payments/s peak",
    "storage": "~10M transactions/day; ledger entries kept 7+ years",
    "notes": "PSP calls take 1–5 s and sometimes time out"
  },
  "outOfScope": ["Fraud detection models", "Building a card network/PSP"],
  "hints": [
    "The PSP call times out. Did the charge happen? What does the retry send?",
    "How do you store money movements so balances can always be recomputed and audited?",
    "Your records and the PSP's records disagree. How do you find out?"
  ],
  "keyComponents": [
    "api_gateway",
    "service",
    "sql_db",
    "message_queue",
    "worker",
    "external_service",
    "batch_processor"
  ],
  "deepDives": [
    "Idempotency keys end-to-end",
    "Double-entry ledger",
    "Outbox pattern / exactly-once effects",
    "Reconciliation"
  ],
  "rubricFocus": [
    "Idempotency",
    "Ledger correctness",
    "Failure handling with PSPs",
    "Reconciliation"
  ],
  "tests": [
    {
      "id": "idempotent",
      "desc": "Payment APIs are idempotent",
      "check": {
        "apiMatch": {
          "method": "POST",
          "idempotent": true
        }
      },
      "hint": "Accept an idempotency key and return the original result on retries."
    },
    {
      "id": "ledger",
      "desc": "Money movements are recorded in a double-entry ledger",
      "check": {
        "anyOf": [
          {
            "entityMatch": {
              "name~": "ledger|entry|journal"
            }
          },
          {
            "mentions": "double.?entry|ledger"
          }
        ]
      }
    },
    {
      "id": "consistency",
      "desc": "Balances use a strongly consistent store",
      "check": {
        "anyOf": [
          {
            "hasNode": "sql_db"
          },
          {
            "nodeConfig": {
              "type": "nosql_kv",
              "config": {
                "consistency": "strong"
              }
            }
          }
        ]
      }
    },
    {
      "id": "psp",
      "desc": "External PSPs are integrated",
      "check": {
        "hasNode": "external_service"
      }
    },
    {
      "id": "reconcile",
      "desc": "Daily reconciliation with PSP reports",
      "check": {
        "mentions": "reconcil"
      }
    },
    {
      "id": "async-retries",
      "desc": "Webhooks / PSP failures are processed with retries",
      "check": {
        "anyOf": [
          {
            "pathExists": {
              "from": "queue",
              "to": "worker"
            }
          },
          {
            "mentions": "retr|webhook"
          }
        ]
      }
    },
    {
      "id": "audit",
      "desc": "Ledger is append-only and auditable",
      "check": {
        "mentions": "append.?only|immutable|audit"
      }
    },
    {
      "id": "auth",
      "desc": "APIs are authenticated",
      "check": {
        "anyOf": [
          {
            "hasNode": "auth_service"
          },
          {
            "apiMatch": {
              "auth": true
            }
          }
        ]
      }
    },
    {
      "id": "scale-out",
      "desc": "Every service sits behind a load balancer or API gateway",
      "check": {
        "upstreamOf": "service",
        "anyType": "entry"
      },
      "hint": "Put a load balancer or API gateway in front of your services so they can scale horizontally."
    }
  ],
  "references": [
    {
      "id": "sync-psp-ledger",
      "name": "Payment service + double-entry ledger",
      "summary": "The payment service stores a payment row (status=PENDING) keyed by idempotency key, calls the PSP with the same key, then writes balanced ledger entries in one SQL transaction. PSP webhooks go through a queue to workers that update status idempotently. A nightly batch job reconciles ledger vs PSP settlement files.",
      "tradeoffs": [
        "Simple request flow",
        "Synchronous PSP latency on the request path",
        "Idempotency key at every hop makes retries safe"
      ],
