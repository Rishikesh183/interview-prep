  "apis": [
    {
      "id": "a1",
      "ownerNodeId": "meta",
      "method": "POST",
      "path": "/v1/files/{path}/upload-session",
      "auth": true,
      "response": "{ missingBlocks: [{hash, presignedUrl}] }"
    },
    {
      "id": "a2",
      "ownerNodeId": "meta",
      "method": "POST",
      "path": "/v1/files/{path}/commit",
      "auth": true,
      "idempotent": true,
      "request": "{ blockHashes[], baseVersion }",
      "statusCodes": "200, 409"
    },
    {
      "id": "a3",
      "ownerNodeId": "meta",
      "method": "GET",
      "path": "/v1/changes",
      "auth": true,
      "pagination": "cursor"
    }
  ],
  "entities": [
    {
      "name": "FileVersion",
      "fields": "file_id, version, block_hashes[], size, modified_by"
    },
    {
      "name": "Block",
      "fields": "hash PK, size, s3_key, ref_count"
    }
  ]
}
