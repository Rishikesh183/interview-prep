                "stateless": true,
                "instancesMin": 2,
                "instancesMax": 10,
                "autoscale": true,
                "language": ""
              },
              "note": "Selective forwarding unit: forwards the right simulcast layer to each receiver (no mixing)"
            }
          },
          {
            "id": "turn",
            "type": "external_service",
            "position": {
              "x": 260,
              "y": 390
