{
  "v": 1,
  "n": [
    {
      "i": "client",
      "t": "web_client",
      "x": 0,
      "y": 0,
      "l": "Job owners",
      "no": "User-facing caller for distributed job scheduler."
    },
    {
      "i": "lb",
      "t": "load_balancer",
      "x": 280,
      "y": 0,
      "l": "LB",
      "no": "Distribute incoming connections across healthy instances for distributed job scheduler."
    },
    {
      "i": "api",
      "t": "service",
      "x": 560,
      "y": 0,
      "l": "Job API",
      "no": "Implement the owned APIs and coordinate state transitions for distributed job scheduler."
    },
    {
      "i": "db",
      "t": "sql_db",
      "x": 840,
      "y": 0,
      "l": "Jobs",
      "c": {
        "replicas": 3,
        "sharding": "hash",
        "shardKey": "partition_id"
      },
      "no": "Indexed by (partition, next_run minute bucket)"
    },
    {
      "i": "sched",
      "t": "scheduler",
      "x": 0,
      "y": 180,
      "l": "Leader scheduler + standby",
      "c": {
        "purpose": "Poll due jobs per owned partition"
      },
      "no": "One fenced leader scans next_run using a min-heap backed by an ordered database index. A standby resumes from durable dispatch markers after leader failure."
    },
    {
      "i": "etcd",
      "t": "coordination",
      "x": 280,
      "y": 180,
      "l": "Leader lease",
      "no": "Elect one scheduler; every dispatch carries a fencing epoch to reject an obsolete leader."
    },
    {
      "i": "q",
      "t": "message_queue",
      "x": 280,
      "y": 360,
      "l": "Dispatch queue",
      "no": "Buffer independently retryable asynchronous work for distributed job scheduler."
    },
    {
      "i": "workers",
      "t": "worker",
      "x": 560,
      "y": 180,
      "l": "Workers",
      "no": "At-least-once; handlers must be idempotent; retry with backoff; visibility timeout covers crashes"
    }
  ],
  "e": [
    {
      "i": "e1",
      "s": "client",
      "d": "lb",
      "l": "Public request",
      "h": "r>l"
    },
    {
      "i": "e2",
      "s": "lb",
      "d": "api",
      "l": "Call Job API",
      "h": "r>l"
    },
    {
      "i": "e3",
      "s": "api",
      "d": "db",
      "o": "w",
      "l": "Read / write state",
      "h": "r>l"
    },
    {
