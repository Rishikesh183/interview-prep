      "s": "brokers",
      "d": "controller",
      "m": "a",
      "o": "rw",
      "l": "Read / write state",
      "h": "r>l"
    },
    {
      "i": "e4",
      "s": "brokers",
      "d": "archive",
      "l": "Offload segments / fetch old offsets",
      "h": "r>l"
    }
  ],
  "apis": [
    {
      "id": "a1",
      "ownerNodeId": "brokers",
      "method": "RPC",
      "path": "Broker.Produce",
      "request": "{ \"topic\": \"events\", \"key\": \"user1\", \"producerId\": \"p1\", \"sequence\": 8, \"value\": \"...\", \"acks\": \"all\" }",
      "response": "{ \"partition\": 3, \"offset\": 1008 }",
      "statusCodes": "OK, NOT_LEADER, NOT_ENOUGH_REPLICAS",
      "auth": true,
      "note": "acks=all waits for the in-sync replica set subject to min ISR; it is not an end-to-end exactly-once guarantee."
    },
    {
      "id": "a2",
      "ownerNodeId": "brokers",
      "method": "RPC",
      "path": "Broker.Fetch",
      "request": "{ \"topic\": \"events\", \"partition\": 3, \"offset\": 1008, \"maxBytes\": 1048576 }",
      "response": "{ \"records\": [], \"nextOffset\": 1010 }",
      "statusCodes": "OK, OFFSET_OUT_OF_RANGE, NOT_LEADER",
      "auth": true,
      "idempotent": true,
      "note": "Consumer groups own partition assignments; keep commit progress separate from fetch position."
    }
  ],
  "entities": [
    {
      "name": "LogRecord",
      "fields": "topic: string\npartition_id: int32\noffset: int64 PK within partition\nkey: bytes\npayload: bytes\nproducer_id: string\nsequence: int64",
      "storeNodeId": "brokers"
    },
    {
      "name": "ConsumerOffset",
      "fields": "group_id: string\ntopic: string\npartition_id: int32\ncommitted_offset: int64",
      "storeNodeId": "brokers"
    }
  ]
}
