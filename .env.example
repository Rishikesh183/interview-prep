# ---------- AI (server-side only; never prefix with NEXT_PUBLIC_) ----------
# Get a key at https://openrouter.ai/keys (free models need no credits, but are rate-limited).
OPENROUTER_API_KEY=
# Any OpenRouter model id. Free ones end in ":free". List: https://openrouter.ai/models?q=free
REVIEW_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Optional stronger model for the "Deep review" button (step 2.7).
DEEP_REVIEW_MODEL=
# Comma-separated fallbacks, tried in order if the main model is rate-limited or down.
REVIEW_FALLBACK_MODELS=qwen/qwen3.8-27b:free,openrouter/free
# Reasoning models: low | medium | high | none. "low" keeps free models fast (default).
REVIEW_REASONING_EFFORT=low
# AI calls allowed per user per day (step 2.7).
DAILY_AI_CALLS=10

# ---------- Supabase (Project Settings → API). Leave empty to run local-only. ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only (budget writes). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Only for `pnpm db:migrate` (Project Settings → Database → Connection string → Session pooler).
DATABASE_URL=
