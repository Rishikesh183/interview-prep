  "apis": [
    {
      "id": "a1",
      "ownerNodeId": "svc",
      "method": "POST",
      "path": "/v1/shows/{showId}/holds",
      "request": "{ \"seatIds\": [\"A1\",\"A2\"], \"requestId\": \"r1\" }",
      "response": "201 { \"holdId\": \"h1\", \"expiresAt\": \"...\" }",
      "statusCodes": "201, 409, 429",
      "auth": true,
      "idempotent": true,
      "note": "The hold must be all-or-nothing and tied to the authenticated owner."
    },
    {
      "id": "a2",
      "ownerNodeId": "svc",
      "method": "POST",
      "path": "/v1/bookings",
      "request": "{ \"holdId\": \"h1\", \"paymentToken\": \"provider-token\", \"requestId\": \"checkout1\" }",
      "response": "201 { \"bookingId\": \"b1\", \"status\": \"CONFIRMED\" }",
      "statusCodes": "201, 402, 409, 410",
      "auth": true,
      "idempotent": true,
      "note": "Use provider idempotency and a durable booking state machine; compensate an authorization if the hold expired before confirmation."
    }
  ],
  "entities": [
    {
      "name": "Seat",
      "fields": "show_id: string\nseat_id: string\nstatus: AVAILABLE|HELD|BOOKED\nhold_id: string?\nheld_until: timestamp?\nPK(show_id, seat_id)",
      "storeNodeId": "db"
    },
    {
      "name": "SeatHold",
      "fields": "hold_id: string\nshow_id: string\nseat_ids: string[]\nowner_id: string\nexpires_at: timestamp\nversion: int64",
