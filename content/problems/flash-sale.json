                "delivery": "at-least-once",
                "dlq": true,
                "fifo": false
              }
            }
          },
          {
            "id": "orders",
            "type": "worker",
            "position": {
              "x": 1040,
              "y": 0
            },
            "data": {
              "label": "Order workers",
              "config": {
                "instances": 2,
                "concurrency": 10
              }
            }
          },
          {
            "id": "db",
            "type": "sql_db",
            "position": {
              "x": 1300,
              "y": 0
            },
            "data": {
              "label": "Orders DB",
              "config": {
                "engine": "PostgreSQL",
                "replicas": 2,
                "readReplicas": false,
                "sharding": "none",
                "shardKey": ""
              }
            }
          },
          {
