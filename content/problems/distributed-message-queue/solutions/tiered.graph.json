    },
    {
      "i": "consumers",
      "t": "worker",
      "x": 560,
      "y": 180,
      "l": "Consumer group",
      "no": "Commit offsets to an internal topic; rebalancing on join/leave"
    },
    {
      "i": "archive",
      "t": "object_storage",
      "x": 560,
      "y": 360,
      "l": "Archived log segments",
      "no": "Immutable sealed segments with checksums; commit segment manifests before evicting local copies."
    }
  ],
  "e": [
    {
      "i": "e1",
      "s": "producers",
      "d": "brokers",
      "m": "a",
