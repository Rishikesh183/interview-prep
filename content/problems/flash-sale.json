          "idempotent": true,
          "rateLimited": true,
          "statusCodes": "202, 409, 429"
        }
      ],
      "entities": []
    },
    {
      "id": "token-bucket-prealloc",
      "name": "Pre-allocated purchase tokens",
      "summary": "Generate 10,000 purchase tokens in advance; a waiting room hands them out FIFO; holding a token lets the user check out normally.",
      "tradeoffs": ["Fair and simple checkout", "Waiting room infrastructure needed"]
    }
  ]
