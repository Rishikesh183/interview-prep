{
  "id": "distributed-message-queue",
  "number": 26,
  "title": "Distributed Message Queue (Kafka)",
  "difficulty": "hard",
  "tags": ["partitions", "offsets", "replication"],
  "prompt": "Design a distributed, durable message queue / log like Kafka: producers append messages to topics; consumer groups read them in order at their own pace.",
  "functionalReqs": [
    "Create topics with partitions",
    "Produce messages (with keys)",
    "Consumer groups with independent offsets",
    "Retention by time/size"
  ],
  "nonFunctionalReqs": [
    "Durable: acknowledged messages survive broker failure",
    "Ordering per partition",
    "Millions of messages/s throughput"
  ],
  "scale": {
    "qps": "~5M messages/s, avg 1 KB",
    "storage": "~400 TB/day; 7-day retention"
  },
  "outOfScope": ["Stream processing", "Exactly-once transactions across topics"],
  "hints": [
    "Where does ordering come from?",
    "Who remembers how far each consumer got?",
    "A broker dies right after acking. Is the message lost?"
  ],
  "keyComponents": ["event_stream", "coordination", "service"],
  "deepDives": [
    "Partitioned append-only logs on disk",
    "Leader/follower replication and ISR",
    "Consumer group rebalancing",
    "acks=all and min.insync.replicas"
  ],
  "rubricFocus": ["Log/partition design", "Replication", "Consumer offsets"],
  "tests": [
    {
      "id": "partitions",
      "desc": "Topics are split into partitions",
      "check": {
        "mentions": "partition"
      }
    },
    {
      "id": "offsets",
      "desc": "Consumers track offsets",
      "check": {
        "mentions": "offset"
      }
    },
    {
      "id": "replication",
      "desc": "Partitions are replicated (leader/followers, ISR)",
      "check": {
        "mentions": "replica|isr|in.?sync|follower"
      }
    },
    {
      "id": "consumer-groups",
      "desc": "Consumer groups share work",
      "check": {
        "mentions": "consumer group|rebalanc"
      }
    },
    {
      "id": "metadata",
      "desc": "Cluster metadata / controller coordination",
      "check": {
        "anyOf": [
          {
            "hasNode": "coordination"
          },
          {
            "mentions": "controller|raft|kraft|zookeeper"
          }
        ]
      }
    },
    {
      "id": "durability",
      "desc": "Producer acknowledgements and durability are defined",
      "check": {
        "mentions": "ack|fsync|durab|min.?insync"
      }
    },
    {
      "id": "retention",
      "desc": "Retention policy exists",
      "check": {
        "mentions": "retention|compaction|ttl"
      }
    },
    {
      "id": "brokers",
      "desc": "Brokers are modelled",
      "check": {
        "anyOf": [
          {
            "hasNode": "event_stream"
          },
          {
            "nodeConfig": {
              "type": "service",
              "text~": "broker"
            }
          }
        ]
      }
    }
  ],
