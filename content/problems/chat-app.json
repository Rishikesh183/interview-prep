{
  "id": "chat-app",
  "number": 7,
  "title": "Chat App (WhatsApp)",
  "difficulty": "medium",
  "priority": true,
  "tags": ["websockets", "pub-sub", "ordering", "write-heavy"],
  "prompt": "Design a 1:1 and small-group chat service like WhatsApp. Users send text messages in real time, see delivery/read receipts and online presence, and receive messages sent while they were offline.",
  "functionalReqs": [
    "1:1 and group chats (up to 256 members)",
    "Real-time message delivery",
    "Offline delivery when the recipient reconnects (+ push notification)",
    "Sent / delivered / read receipts",
    "Online presence / last seen",
    "Message history sync across devices"
  ],
  "nonFunctionalReqs": [
    "Low latency delivery (< 200 ms p99 within a region)",
    "Messages are never lost and arrive in order per conversation",
    "Highly available; tolerate WebSocket node failures"
  ],
  "scale": {
    "dau": "~500M DAU",
    "qps": "~40 messages/user/day → ~230K messages/s avg, ~700K/s peak",
    "storage": "~100 B per message → ~2 TB/day",
    "notes": "~50M concurrent connections"
  },
  "outOfScope": ["Voice / video calls", "End-to-end encryption key exchange details"],
  "hints": [
    "Recipients may be connected to a different WebSocket server than the sender. How does the message get there?",
    "Messages are write-heavy and read by conversation + time. Which store fits that access pattern?",
    "Ordering per conversation: who assigns the sequence?"
  ],
  "keyComponents": [
    "load_balancer",
    "websocket_server",
    "pub_sub",
    "wide_column",
    "cache",
    "notification_service"
  ],
  "deepDives": [
    "Routing messages across WebSocket nodes (pub/sub, session registry)",
    "Per-conversation ordering and message IDs",
    "Offline delivery and push notifications",
    "Read receipts and presence at scale"
  ],
  "rubricFocus": [
    "Real-time transport",
    "Cross-node delivery",
    "Message storage model",
    "Delivery guarantees"
  ],
  "tests": [
    {
      "id": "realtime",
      "desc": "Clients hold persistent connections for real-time delivery",
      "check": {
        "hasNode": "websocket_server"
      },
      "hint": "Use WebSocket servers for bidirectional real-time messaging."
    },
    {
      "id": "cross-node",
      "desc": "Messages can reach users connected to a different WebSocket node",
      "check": {
        "anyOf": [
          {
            "edgeMatch": {
              "from": "websocket_server",
              "to": "queue"
            }
          },
          {
            "edgeMatch": {
              "from": "queue",
              "to": "websocket_server"
            }
          }
        ]
      },
      "hint": "Connect WebSocket servers through pub/sub or a stream so a message can hop between nodes."
    },
    {
      "id": "message-store",
      "desc": "Messages are persisted",
      "check": {
        "pathExists": {
          "from": "websocket_server",
          "to": "db"
        }
      }
    },
    {
      "id": "offline",
      "desc": "Offline users get messages later (and a push notification)",
      "check": {
        "anyOf": [
          {
            "hasNode": "notification_service"
          },
          {
            "mentions": "offline|push notif|apns|fcm"
          }
        ]
      }
    },
    {
      "id": "ordering",
      "desc": "Per-conversation ordering is addressed",
      "check": {
        "mentions": "order|sequence|monotonic|snowflake"
      }
    },
    {
      "id": "presence",
      "desc": "Presence / last seen is handled",
      "check": {
        "mentions": "presence|online|heartbeat|last.?seen"
      }
    },
    {
      "id": "receipts",
      "desc": "Delivery and read receipts are handled",
      "check": {
        "mentions": "receipt|delivered|ack"
      }
    },
    {
      "id": "history-api",
      "desc": "Message history is fetched with cursor pagination",
      "check": {
        "apiMatch": {
          "method": "GET",
          "path~": "message|history|conversation|chat",
          "pagination": "cursor"
        }
      }
    },
    {
      "id": "ws-entry",
      "desc": "WebSocket servers sit behind a load balancer",
      "check": {
        "upstreamOf": "websocket_server",
        "anyType": "entry"
      }
    }
  ],
  "references": [
    {
      "id": "ws-pubsub-cassandra",
      "name": "WebSockets + Redis pub/sub + Cassandra",
      "summary": "Clients keep a WebSocket to a chat server (sticky via L4 LB). A message is assigned a per-conversation sequence, written to Cassandra (partition = conversation_id, clustering = message_id) and published to a Redis channel per user; whichever server holds the recipient's socket delivers it. If the recipient is offline the message waits in storage and a push notification goes out.",
      "tradeoffs": [
        "Redis pub/sub is fire-and-forget; durability comes from writing to Cassandra first",
        "Cassandra handles the write-heavy load and time-ordered reads per conversation",
        "Presence via heartbeats in Redis with short TTLs"
      ],
